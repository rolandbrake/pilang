import math.{log10, exp}


// compute the softmax of a vector f(z) = exp(z) / sum(exp(z))
fun softmax(z) {
    let max_z = z[0]
    for i in range(1, #z) {
        if z[i] > max_z {
            max_z = z[i]
        }
    }

    let exp_z = []
    let sum_exp_z = 0
    for i in range(#z) {
        let exp_i = exp(z[i] - max_z)
        exp_z += exp_i
        sum_exp_z += exp_i
    }

    let softmax_z = []
    for i in range(#z) {
        softmax_z += exp_z[i] / sum_exp_z
    }

    return softmax_z
}


fun sigmoid(z) {
    return 1 / (1 + exp(-z))
}
fun compute_cost(x, y, w, b) {
    let cost = 0
    let m = #x

    for i in range(m) {
        let f_wb = sigmoid(w * x[i] + b)
        let cost_i = -y[i] * log10(f_wb) - (1 - y[i]) * log10(1 - f_wb)
        cost += cost_i
    }

    cost /= m
    return cost
}

fun compute_gradient(x, y, w, b) {
    let m = #x
    let dj_dw = 0
    let dj_db = 0

    for i in range(m) {
        let f_wb_i = sigmoid(w * x[i] + b)
        let error_i = f_wb_i - y[i]
        dj_dw += error_i * x[i]
        dj_db += error_i
    }

    dj_dw /= m
    dj_db /= m

    return (dj_dw, dj_db)
}

