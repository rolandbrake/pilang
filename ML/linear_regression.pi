import io.{format}
import math.{ceil}


// Larger dataset with some noise
// x_train = [1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 4.0, 4.5, 5.0, 5.5, 6.0, 6.5]
// y_train = [320.0, 360.0, 510.0, 600.0, 690.0, 810.0, 880.0, 990.0, 1080.0, 1190.0, 1300.0, 1380.0]

// Load our data set
// x_train = [1.0, 2.0]  //features
// y_train = [300.0, 500.0]   //target value

x_train = []
y_train = []

for i in range(1, 51) {
    let x = i * 0.5
    let noise = (rand() - 0.5) * 50   // small randomness
    let y = 200 * x + 100 + noise

    x_train += x
    y_train += y
}




fun compute_cost(x, y, w, b) {
    /* Computes the cost function for linear regression.
    
    Args:
      x (list (m,)): Data, m examples 
      y (list (m,)): target values
      w,b (scalar)    : model parameters  
    
    Returns
        total_cost (float): The cost of using w,b as the parameters for linear regression
               to fit the data points in x and y
    */
    // number of training examples
    let m = #x 
    
    let cost_sum = 0 
    for i in range(m) { 
        let f_wb = w * x[i] + b   
        let cost = (f_wb - y[i]) ** 2  
        cost_sum += cost  
    }
    let total_cost = (1 / (2 * m)) * cost_sum  

    return total_cost
}

fun compute_gradient(x, y, w, b) {
    /*
    Computes the gradient for linear regression
    Args:
      x (list (m,)): Data, m examples 
      y (list (m,)): target values
      w,b (scalar)    : model parameters  
    
    Returns
      dj_dw (scalar): The gradient of the cost w.r.t. the parameters w
      dj_db (scalar): The gradient of the cost w.r.t. the parameter b    

    */

    // Number of training examples
    let m = #x
    
    let dj_dw = 0
    let dj_db = 0
    
    for i in range(m) {
        let f_wb_i = w * x[i] + b
        let dj_dw_i = (f_wb_i - y[i]) * x[i]
        let dj_db_i = f_wb_i - y[i]
        dj_dw = dj_dw + dj_dw_i
        dj_db = dj_db + dj_db_i
    }

    dj_dw = dj_dw / m
    dj_db = dj_db / m

    return [dj_db, dj_dw]
}


fun gradient_descent(x, y, w_in, b_in, alpha, num_iters, 
                  cost_function, gradient_function) {
    /*
    Performs gradient descent to learn w and b. Updates w and b by taking 
    num_iters gradient steps with learning rate alpha
    
    Args:
      x (list (m,)): Data, m examples 
      y (list (m,)): target values
      w_in,b_in (scalar): initial values of model parameters  
      alpha (float): learning rate
      num_iters (int): number of iterations to run gradient descent
      cost_function (function): function to compute cost
      gradient_function (function): function to compute the gradient
    
    Returns:
      w (scalar): updated value of parameter after running gradient descent
      b (scalar): updated value of parameter after running gradient descent
      history_cost (list): history of the cost at each iteration
      history_w (list): history of the w at each iteration
      history_b (list): history of the bias at each iteration
    */

    let w = w_in, b = b_in    
    let w_history = [], b_history = [], cost_history = []    
    
    let dj_db = 0, dj_dw = 0

    for i in range(num_iters) {
        [dj_db, dj_dw] = gradient_function(x, y, w, b)

        w = w - alpha * dj_dw
        b = b - alpha * dj_db

        if i < 100 || i % 1000 == 0 {
            w_history += w
            b_history += b
            cost_history += cost_function(x, y, w, b)            
        }
    }        
    
    return [w, b, cost_history, w_history, b_history]
}


// initialize parameters
w_init = 0
b_init = 0
// some gradient descent settings
iterations = 10000
alpha = 0.004

[w_final, b_final, cost_history, w_history, b_history] = gradient_descent(x_train, y_train, w_init, b_init,
                                                         alpha, iterations, compute_cost, compute_gradient)


println("(w,b) found by gradient descent:", w_final, b_final)
println("initial w,b:", w_init, b_init)
println("cost at end:", compute_cost(x_train, y_train, w_final, b_final))




