// Regex module implemented in Pilang.
//
// Public API:
// - escape(pattern)
// - test(pattern, text)
// - search(pattern, text)
// - match(pattern, text)
// - findall(pattern, text)
// - replace(pattern, text, repl)
// - split(pattern, text)
//
// Supported pattern features:
// - literals
// - . wildcard
// - *, +, ? quantifiers
// - ^ and $ anchors
// - character classes like [abc], [a-z], and [^0-9]
// - shorthand escapes: \d, \w, \s, \n, \r, \t
//
// search() returns a map shaped like:
//   {match: "...", start: 0, end: 3}
//
// Implementation note: this is a small backtracking matcher, not a full PCRE
// engine. It intentionally avoids advanced features such as groups, lookaround,
// alternation, and lazy quantifiers.
import col.{contains}
import string.{is_alnum:string_is_alnum}

// Creates a token map used by the compiled pattern representation.
fun _regex_makeToken(type, value) {
    let token = {};
    token["type"] = type;
    token["quant"] = nil;

    if (type == "literal")
        token["char"] = value;
    elif (type == "class")
        token["chars"] = value;
    elif (type == "anchor")
        token["mode"] = value;
    return token;
}

// Local substring helper used by the matcher.
fun _regex_substr(text, start, stop) {
    if (start < 0)
        start = len(text) + start;
    if (stop < 0)
        stop = len(text) + stop;
    if (start < 0)
        start = 0;
    if (stop > len(text))
        stop = len(text);

    let result = "";
    let i = start;
    while (i < stop) {
        result = concat(result, text[i]);
        i = i + 1;
    }
    return result;
}

// Builds every character between two class endpoints, inclusive.
fun _regex_rangeChars(start_char, end_char) {
    let chars = "";
    let a = ord(start_char);
    let b = ord(end_char);
    if (a <= b) {
        let i = a;
        while (i <= b) {
            chars = concat(chars, char(i));
            i = i + 1;
        }
    } else {
        let i = a;
        while (i >= b) {
            chars = concat(chars, char(i));
            i = i - 1;
        }
    }
    return chars;
}

// Parses a character class body and returns [token, next_index].
fun _regex_parseClass(pattern, index) {
    let chars = "";
    let negated = false;
    let i = index;

    if (i < len(pattern) && pattern[i] == "^") {
        negated = true;
        i = i + 1;
    }

    while (i < len(pattern) && pattern[i] != "]") {
        if (pattern[i] == "\\") {
            i = i + 1;
            if (i >= len(pattern))
                chars = concat(chars, char(92));
            else
                chars = concat(chars, pattern[i]);
            i = i + 1;
            continue;
        }

        if (i + 2 < len(pattern) && pattern[i + 1] == "-" && pattern[i + 2] != "]") {
            chars = concat(chars, _regex_rangeChars(pattern[i], pattern[i + 2]));
            i = i + 3;
            continue;
        }

        chars = concat(chars, pattern[i]);
        i = i + 1;
    }

    if (i < len(pattern) && pattern[i] == "]")
        i = i + 1;

    let token = _regex_makeToken("class", chars);
    token["negated"] = negated;
    return [token, i];
}

// Tests whether a compiled token accepts the current text character.
fun _regex_tokenMatches(token, ch) {
    if (len(ch) == 0)
        return false;

    if (token["type"] == "dot")
        return true;

    if (token["type"] == "literal")
        return ch == token["char"];

    if (token["type"] == "digit")
        return contains("0123456789", ch);

    if (token["type"] == "word")
        return string_is_alnum(ch) || ch == "_";

    if (token["type"] == "space")
        return contains(" \t\n\r", ch);

    if (token["type"] == "class") {
        let match = contains(token["chars"], ch);
        if (token["negated"])
            return !match;
        return match;
    }

    return false;
}

// Compiles a pattern string into token maps.
fun _regex_compile(pattern) {
    let tokens = [];
    let i = 0;

    while (i < len(pattern)) {
        let ch = pattern[i];
        let token = nil;

        if (ch == "\\") {
            i = i + 1;
            if (i >= len(pattern))
                token = _regex_makeToken("literal", "\\");
            else {
                let esc = pattern[i];
                if (esc == "d")
                    token = _regex_makeToken("digit", nil);
                elif (esc == "w")
                    token = _regex_makeToken("word", nil);
                elif (esc == "s")
                    token = _regex_makeToken("space", nil);
                elif (esc == "n")
                    token = _regex_makeToken("literal", "\n");
                elif (esc == "r")
                    token = _regex_makeToken("literal", "\r");
                elif (esc == "t")
                    token = _regex_makeToken("literal", "\t");
                else
                    token = _regex_makeToken("literal", esc);
            }
        }
        elif (ch == ".")
            token = _regex_makeToken("dot", nil);
        elif (ch == "[") {
            let result = _regex_parseClass(pattern, i + 1);
            token = result[0];
            i = result[1] - 1;
        }
        elif (ch == "^" && len(tokens) == 0)
            token = _regex_makeToken("anchor", "start");
        elif (ch == "$" && i == len(pattern) - 1)
            token = _regex_makeToken("anchor", "end");
        else
            token = _regex_makeToken("literal", ch);

        tokens += token;
        i = i + 1;

        if (i < len(pattern)) {
            let next_ch = pattern[i];
            if ((next_ch == "*" || next_ch == "+" || next_ch == "?") && token["type"] != "anchor") {
                tokens[len(tokens) - 1]["quant"] = next_ch;
                i = i + 1;
            }
        }
    }

    return tokens;
}

// Matches tokens from a given text position. Internal result shape is:
// [matched_text, start_index, end_index].
fun _regex_matchHere(text, start, pos, tokens, pi) {
    if (pi == len(tokens)) {
        return [_regex_substr(text, start, pos), start, pos];
    }

    let token = tokens[pi];
    if (token["type"] == "anchor") {
        if (token["mode"] == "end") {
            if (pos == len(text))
                return [_regex_substr(text, start, pos), start, pos];
            return nil;
        }
        return _regex_matchHere(text, start, pos, tokens, pi + 1);
    }

    let quant = token["quant"];
    if (quant == "*")
        return _regex_matchStar(text, start, pos, tokens, pi);
    if (quant == "+")
        return _regex_matchPlus(text, start, pos, tokens, pi);
    if (quant == "?")
        return _regex_matchOptional(text, start, pos, tokens, pi);

    if (pos < len(text) && _regex_tokenMatches(token, text[pos]))
        return _regex_matchHere(text, start, pos + 1, tokens, pi + 1);

    return nil;
}

// Greedy `*` handling with backtracking.
fun _regex_matchStar(text, start, pos, tokens, pi) {
    let token = tokens[pi];
    let next = pi + 1;
    let max = pos;

    while (max < len(text) && _regex_tokenMatches(token, text[max]))
        max = max + 1;

    let j = max;
    while (j >= pos) {
        let result = _regex_matchHere(text, start, j, tokens, next);
        if (result != nil)
            return result;
        j = j - 1;
    }
    return nil;
}

// `+` requires one match, then reuses star handling for the rest.
fun _regex_matchPlus(text, start, pos, tokens, pi) {
    let token = tokens[pi];
    if (pos >= len(text) || !_regex_tokenMatches(token, text[pos]))
        return nil;
    return _regex_matchStar(text, start, pos + 1, tokens, pi);
}

// `?` first tries the zero-width branch, then the one-character branch.
fun _regex_matchOptional(text, start, pos, tokens, pi) {
    let token = tokens[pi];
    let next = pi + 1;

    let result = _regex_matchHere(text, start, pos, tokens, next);
    if (result != nil)
        return result;

    if (pos < len(text) && _regex_tokenMatches(token, text[pos]))
        return _regex_matchHere(text, start, pos + 1, tokens, next);

    return nil;
}

// Attempts to match a compiled pattern at one specific text position.
fun _regex_matchAt(text, start, tokens) {
    if (len(tokens) > 0 && tokens[0]["type"] == "anchor" && tokens[0]["mode"] == "start")
        return _regex_matchHere(text, start, start, tokens, 1);

    return _regex_matchHere(text, start, start, tokens, 0);
}

// Searches from an offset until a match is found or text is exhausted.
fun _regex_searchFrom(text, start, tokens) {
    let i = start;
    while (i <= len(text)) {
        let result = _regex_matchAt(text, i, tokens);
        if (result != nil)
            return result;
        i = i + 1;
    }
    return nil;
}

// Escapes regex metacharacters in plain text so it can be used literally.
fun escape(pattern) {
    let special = concat(".*+?^$()[]{}|", char(92));
    let output = "";
    let i = 0;    

    while (i < len(pattern)) {        
        let ch = pattern[i];        
        if (contains(special, ch))
            output = concat(concat(output, char(92)), ch);
        else
            output = concat(output, ch);
        i = i + 1;
    }

    return output;
}

// Returns true when the pattern appears anywhere in text.
fun test(pattern, text) {
    let tokens = _regex_compile(pattern);
    return _regex_searchFrom(text, 0, tokens) != nil;
}

// Returns the first match as {match, start, end}, or nil when not found.
fun search(pattern, text) {    
    let tokens = _regex_compile(pattern);
    let result = _regex_searchFrom(text, 0, tokens);
    if (result == nil)
        return nil;

    return {"match": result[0], "start": result[1], "end": result[2]};
}

// Returns only the matched text for the first match, or nil when not found.
fun match(pattern, text) {    
    let result = search(pattern, text);    
    if (result == nil)
        return nil;
    return result["match"];
}

// Returns all non-overlapping matches as a list of strings.
fun findall(pattern, text) {
    let tokens = _regex_compile(pattern);
    let matches = [];
    let cursor = 0;

    while (cursor <= len(text)) {
        let result = _regex_searchFrom(text, cursor, tokens);
        if (result == nil)
            break;
        matches += result[0];

        let next_cursor = result[1] + len(result[0]);
        if (next_cursor <= cursor)
            cursor = cursor + 1;
        else
            cursor = next_cursor;
    }

    return matches;
}

// Replaces all non-overlapping matches with `repl`.
fun replace(pattern, text, repl) {
    let output = "";
    let cursor = 0;

    while (cursor < len(text)) {
        let remaining = _regex_substr(text, cursor, len(text));
        let result = search(pattern, remaining);
        if (result == nil)
            break;

        let start = cursor + result["start"];
        let match_text = result["match"];
        let next_cursor = start + len(match_text);

        output = concat(output, text[cursor:start]);
        output = concat(output, repl);

        if (next_cursor <= cursor)
            cursor = cursor + 1;
        else
            cursor = next_cursor;
    }

    output = concat(output, text[cursor:]);
    return output;
}

// Splits text around non-overlapping matches. Empty edge pieces are preserved.
fun split(pattern, text) {
    if (pattern == "") {
        let parts = [];
        let i = 0;
        while (i < len(text)) {
            parts += text[i];
            i = i + 1;
        }
        return parts;
    }

    let parts = [];
    let cursor = 0;

    while (cursor < len(text)) {
        let remaining = _regex_substr(text, cursor, len(text));
        let result = search(pattern, remaining);
        if (result == nil)
            break;

        let start = cursor + result["start"];
        let match_text = result["match"];
        let next_cursor = start + len(match_text);

        parts += text[cursor:start];

        if (next_cursor <= cursor)
            cursor = cursor + 1;
        else
            cursor = next_cursor;
    }

    parts += text[cursor:];
    return parts;
}
