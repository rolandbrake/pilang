// JSON module for Pilang.
//
// Public API:
// - parse(text), loads(text)
// - stringify(value, indent = nil), dumps(value, indent = nil)
//
// parse()/loads() convert JSON text into Pilang values:
// - JSON object -> map
// - JSON array -> list
// - string/number/boolean/null -> string/number/boolean/nil
//
// stringify()/dumps() convert Pilang values back to JSON text. Passing an
// indent string, such as "  ", enables pretty printed output.
//
// Implementation note: this module uses concat() for string construction
// because plain `+` may coerce numeric-looking strings.

// True when a character is JSON whitespace.
fun _json_isWhitespace(ch) {
    return contains(" \t\n\r", ch);
}

// Advances over whitespace and returns the next non-space position.
fun _json_skip(text, pos) {
    while (pos < len(text) && _json_isWhitespace(text[pos])) {
        pos = pos + 1;
    }
    return pos;
}

// Converts one hexadecimal digit to its numeric value.
fun _json_hexValue(ch) {
    if (contains("0123456789", ch))
        return as_num(ch);

    let lowerChar = lower(ch);
    if (lowerChar == "a")
        return 10;
    if (lowerChar == "b")
        return 11;
    if (lowerChar == "c")
        return 12;
    if (lowerChar == "d")
        return 13;
    if (lowerChar == "e")
        return 14;
    if (lowerChar == "f")
        return 15;
    return nil;
}

// Parses the four hex digits following a JSON \u escape.
// Returns [character, next_position], or ["", original_position] on failure.
fun _json_parseUnicode(text, pos) {
    let code = 0;

    for i in range(0, 4) {
        if (pos + i >= len(text))
            return ["", pos];

        let hexChar = lower(text[pos + i]);
        let digit = _json_hexValue(hexChar);
        if (digit == nil)
            return ["", pos];

        code = code * 16 + digit;
    }

    return [char(code), pos + 4];
}

// Parses a JSON string starting at `pos`.
// Returns [string_value, next_position], or [nil, position] on failure.
fun _json_parseString(text, pos) {
    let result = "";
    if (pos >= len(text) || text[pos] != char(34))
        return [nil, pos];

    pos = pos + 1;
    while (pos < len(text)) {
        let ch = text[pos];
        if (ch == char(34)) {
            return [result, pos + 1];
        }

        if (ch == char(92)) {
            pos = pos + 1;
            if (pos >= len(text))
                break;

            let esc = text[pos];
            if (esc == char(34))
                result = concat(result, char(34));
            elif (esc == char(92))
                result = concat(result, char(92));
            elif (esc == "/")
                result = concat(result, "/");
            elif (esc == "b")
                result = concat(result, char(8));
            elif (esc == "f")
                result = concat(result, char(12));
            elif (esc == "n")
                result = concat(result, "\n");
            elif (esc == "r")
                result = concat(result, "\r");
            elif (esc == "t")
                result = concat(result, "\t");
            elif (esc == "u") {
                let unicode = _json_parseUnicode(text, pos + 1);
                if (unicode[0] == "")
                    return [nil, pos];
                result = concat(result, unicode[0]);
                pos = unicode[1] - 1;
            } else
                result = concat(result, esc);
        } else {
            result = concat(result, ch);
        }

        pos = pos + 1;
    }

    return [nil, pos];
}

// Parses a JSON number and returns [number_value, next_position].
fun _json_parseNumber(text, pos) {
    let start = pos;

    if (pos < len(text) && text[pos] == '-')
        pos = pos + 1;

    while (pos < len(text) && contains("0123456789", text[pos]))
        pos = pos + 1;

    if (pos < len(text) && text[pos] == '.') {
        pos = pos + 1;
        while (pos < len(text) && contains("0123456789", text[pos]))
            pos = pos + 1;
    }

    if (pos < len(text) && (text[pos] == 'e' || text[pos] == 'E')) {
        pos = pos + 1;
        if (pos < len(text) && (text[pos] == '+' || text[pos] == '-'))
            pos = pos + 1;
        while (pos < len(text) && contains("0123456789", text[pos]))
            pos = pos + 1;
    }

    let numberText = _json_trim(_json_substr(text, start, pos));
    let number = as_num(numberText);
    return [number, pos];
}

// Parses true, false, or null.
fun _json_parseLiteral(text, pos) {
    if (len(text) - pos >= 4 && _json_substr(text, pos, pos + 4) == "true")
        return [true, pos + 4];
    if (len(text) - pos >= 5 && _json_substr(text, pos, pos + 5) == "false")
        return [false, pos + 5];
    if (len(text) - pos >= 4 && _json_substr(text, pos, pos + 4) == "null")
        return [nil, pos + 4];
    return [nil, pos];
}

// Dispatches to the correct parser for the next JSON value.
fun _json_parseValue(text, pos) {
    pos = _json_skip(text, pos);
    if (pos >= len(text))
        return [nil, pos];

    let ch = text[pos];
    if (ch == '{')
        return _json_parseObject(text, pos);
    if (ch == '[')
        return _json_parseArray(text, pos);
    if (ch == '"')
        return _json_parseString(text, pos);
    if (ch == '-' || contains("0123456789", ch))
        return _json_parseNumber(text, pos);

    return _json_parseLiteral(text, pos);
}

// Parses a JSON array into a Pilang list.
fun _json_parseArray(text, pos) {
    let arr = [];
    pos = pos + 1;
    pos = _json_skip(text, pos);

    if (pos < len(text) && text[pos] == ']')
        return [arr, pos + 1];

    while (pos < len(text)) {
        let item = _json_parseValue(text, pos);
        if (item[0] == nil && item[1] == pos)
            return [nil, pos];

        arr += item[0];
        pos = _json_skip(text, item[1]);

        if (pos < len(text) && text[pos] == ']')
            return [arr, pos + 1];

        if (pos >= len(text) || text[pos] != ',')
            return [nil, pos];

        pos = pos + 1;
        pos = _json_skip(text, pos);
    }

    return [nil, pos];
}

// Parses a JSON object into a Pilang map.
fun _json_parseObject(text, pos) {
    let obj = {};
    pos = pos + 1;
    pos = _json_skip(text, pos);

    if (pos < len(text) && text[pos] == '}')
        return [obj, pos + 1];

    while (pos < len(text)) {
        let keyValue = _json_parseString(text, pos);
        if (keyValue[0] == nil)
            return [nil, pos];

        let key = keyValue[0];
        pos = _json_skip(text, keyValue[1]);
        if (pos >= len(text) || text[pos] != ':')
            return [nil, pos];

        pos = pos + 1;
        let valuePair = _json_parseValue(text, pos);
        if (valuePair[0] == nil && valuePair[1] == pos)
            return [nil, pos];

        obj[key] = valuePair[0];
        pos = _json_skip(text, valuePair[1]);

        if (pos < len(text) && text[pos] == '}')
            return [obj, pos + 1];

        if (pos >= len(text) || text[pos] != ',')
            return [nil, pos];

        pos = pos + 1;
        pos = _json_skip(text, pos);
    }

    return [nil, pos];
}

// Safe substring helper used by the parser.
fun _json_substr(text, start, end) {
    if (start < 0)
        start = 0;
    if (end < start)
        return "";
    if (end > len(text))
        end = len(text);

    let result = "";
    let i = start;
    while (i < end) {
        result = concat(result, text[i]);
        i = i + 1;
    }
    return result;
}

// Trims JSON whitespace from both ends of a string.
fun _json_trim(text) {
    let start = 0;
    while (start < len(text) && _json_isWhitespace(text[start]))
        start = start + 1;

    let end = len(text);
    while (end > start && _json_isWhitespace(text[end - 1]))
        end = end - 1;

    return _json_substr(text, start, end);
}

// Parses an entire JSON document. Returns nil for invalid input.
fun parse(text) {
    if (text == nil)
        return nil;

    let pos = _json_skip(text, 0);
    let valuePair = _json_parseValue(text, pos);
    let endPos = _json_skip(text, valuePair[1]);
    if (valuePair[0] == nil || endPos != len(text))
        return nil;

    return valuePair[0];
}

// Quotes and escapes a string according to JSON rules.
fun _json_quoteString(value) {
    let escaped = "";
    let i = 0;
    while (i < len(value)) {
        let ch = value[i];
        if (ch == char(34))
            escaped = concat(concat(escaped, char(92)), char(34));
        elif (ch == char(92))
            escaped = concat(concat(escaped, char(92)), char(92));
        elif (ch == char(8))
            escaped = concat(concat(escaped, char(92)), "b");
        elif (ch == char(12))
            escaped = concat(concat(escaped, char(92)), "f");
        elif (ch == "\n")
            escaped = concat(concat(escaped, char(92)), "n");
        elif (ch == "\r")
            escaped = concat(concat(escaped, char(92)), "r");
        elif (ch == "\t")
            escaped = concat(concat(escaped, char(92)), "t");
        else
            escaped = concat(escaped, ch);
        i = i + 1;
    }
    return concat(concat(char(34), escaped), char(34));
}

// Joins pre-rendered JSON fragments.
fun _json_join(parts, sep) {
    let result = "";
    for i in range(0, len(parts)) {
        if (i > 0)
            result = concat(result, sep);
        result = concat(result, parts[i]);
    }
    return result;
}

// Builds indentation for pretty-printed JSON.
fun _json_indent(depth, indent) {
    let result = "";
    let i = 0;
    while (i < depth) {
        result = concat(result, indent);
        i = i + 1;
    }
    return result;
}

// Recursive JSON renderer. `indent == nil` means compact output.
fun _json_stringify(value, indent, depth) {
    if (value == nil)
        return "null";
    if (value == true)
        return "true";
    if (value == false)
        return "false";
    if (is_str(value))
        return _json_quoteString(as_string(value));
    if (is_num(value))
        return as_string(value);
    if (is_list(value)) {
        if (len(value) == 0)
            return "[]";

        let items = [];
        for item in value {
            items += _json_stringify(item, indent, depth + 1);
        }

        if (indent == nil)
            return concat(concat("[", _json_join(items, ",")), "]");

        let padded = [];
        for item in items {
            padded += concat(_json_indent(depth + 1, indent), item);
        }

        return concat(concat(concat(concat("[\n", _json_join(padded, ",\n")), "\n"), _json_indent(depth, indent)), "]");
    }
    if (is_map(value)) {
        if (len(value) == 0)
            return "{}";

        let pairs = [];
        for key in value {
            let entry = concat(_json_quoteString(as_string(key)), ":");
            if (indent != nil)
                entry = concat(entry, " ");
            entry = concat(entry, _json_stringify(value[key], indent, depth + 1));
            pairs += entry;
        }

        if (indent == nil)
            return concat(concat("{", _json_join(pairs, ",")), "}");

        let padded = [];
        for entry in pairs {
            padded += concat(_json_indent(depth + 1, indent), entry);
        }

        return concat(concat(concat(concat("{\n", _json_join(padded, ",\n")), "\n"), _json_indent(depth, indent)), "}");
    }

    return _json_quoteString(as_string(value));
}

// Serializes a Pilang value to JSON text.
fun stringify(value, indent = nil) {
    return _json_stringify(value, indent, 0);
}

// Alias for parse(), matching common JSON library naming.
fun loads(text) {
    return parse(text);
}

// Alias for stringify(), matching common JSON library naming.
fun dumps(value, indent = nil) {
    return stringify(value, indent);
}
