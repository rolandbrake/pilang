// CSV helper library for Pilang.
//
// Public API:
// - parse(csv, delimiter = ",", header = true)
// - stringify(rows, delimiter = ",")
//
// parse() returns a list of maps when `header` is true:
//   csv.parse("name,score\nAda,10") -> [{name: "Ada", score: "10"}]
//
// parse() returns raw rows when `header` is false:
//   csv.parse("Ada,10", ",", false) -> [["Ada", "10"]]
//
// stringify() accepts either a list of maps or a list of row lists.
// This module keeps fields as text and supports quoted commas, newlines,
// and doubled quotes inside quoted fields.

// Splits normalized CSV text into physical lines. Quoted multiline fields are
// not currently merged here, so this parser is intended for lightweight CSV.
fun _csv_splitLines(text) {
    let lines = [];
    let start = 0;
    let i = 0;

    while (i < len(text)) {
        if (text[i] == char(10)) {
            lines += text[start:i];
            start = i + 1;
        }
        i = i + 1;
    }

    lines += text[start:];
    return lines;
}

// Converts CRLF and CR newlines to LF without using string.replace, because
// generic string `+` can coerce numeric-looking fragments in this runtime.
fun _csv_normalizeNewlines(text) {
    let result = "";
    let i = 0;

    while (i < len(text)) {
        if (text[i] == char(13)) {
            if (i + 1 < len(text) && text[i + 1] == char(10))
                i = i + 1;
            result = concat(result, char(10));
        } else {
            result = concat(result, text[i]);
        }
        i = i + 1;
    }

    return result;
}

// Doubles quotes inside a field before wrapping it in CSV quotes.
fun _csv_escapeQuotes(text) {
    let result = "";

    for ch in text {
        if (ch == '"')
            result = concat(result, '""');
        else
            result = concat(result, ch);
    }

    return result;
}

// Parses one CSV line into a list of field strings. Handles quoted fields and
// escaped quotes represented as two quotes.
fun _csv_parseLine(line, delimiter = ",") {
    let fields = [];
    let field = "";
    let inQuotes = false;
    let i = 0;

    while (i < len(line)) {
        let ch = line[i];

        if (inQuotes) {
            if (ch == '"') {
                if (i + 1 < len(line) && line[i + 1] == '"') {
                    field = concat(field, '"');
                    i = i + 1;
                } else {
                    inQuotes = false;
                }
            } else {
                field = concat(field, ch);
            }
        } else {
            if (ch == '"') {
                inQuotes = true;
            } elif (ch == delimiter) {
                fields += field;
                field = "";
            } else {
                field = concat(field, ch);
            }
        }

        i = i + 1;
    }

    fields += field;
    return fields;
}

// Converts one field to a CSV-safe string. Fields containing delimiter,
// newlines, carriage returns, or quotes are quoted.
fun _csv_escape(value, delimiter = ",") {
    if (value == nil)
        value = "";

    let text = as_string(value);
    text = _csv_escapeQuotes(text);

    if (contains(text, delimiter) || contains(text, "\n") || contains(text, "\r") || contains(text, '"')) {
        return concat('"', text, '"');
    }

    return text;
}

// Parses CSV text.
//
// If header is true, the first row becomes map keys and the remaining rows are
// returned as records. If header is false, returns the raw list of rows.
fun parse(csv, delimiter = ",", header = true) {
    let text = _csv_normalizeNewlines(csv);

    let rows = [];
    for line in _csv_splitLines(text) {
        if (len(trim(line)) == 0)
            continue;
        rows += _csv_parseLine(line, delimiter);
    }

    if (len(rows) == 0)
        return [];

    if (!header)
        return rows;

    let headers = rows[0];
    let result = [];

    for i in range(1, len(rows)) {
        let row = rows[i];
        let record = {};

        for j in range(0, len(headers)) {
            let key = headers[j];
            let value = "";
            if (j < len(row))
                value = row[j];
            record[key] = value;
        }

        result += record;
    }

    return result;
}

// Serializes rows to CSV text. For map rows, keys from the first map define
// both the header order and value order for all subsequent rows.
fun stringify(rows, delimiter = ",") {
    if (len(rows) == 0)
        return "";

    let first = rows[0];
    let lines = [];

    if (is_map(first)) {
        let headers = [];
        for key in first {
            headers += key;
        }

        let headerFields = [];
        for key in headers {
            headerFields += _csv_escape(key, delimiter);
        }
        lines += _csv_join(headerFields, delimiter);

        for row in rows {
            let values = [];
            for key in headers {
                values += _csv_escape(row[key], delimiter);
            }
            lines += _csv_join(values, delimiter);
        }
    } else {
        for row in rows {
            let fields = [];
            for cell in row {
                fields += _csv_escape(cell, delimiter);
            }
            lines += _csv_join(fields, delimiter);
        }
    }

    return _csv_join(lines, "\n");
}

// Joins already-escaped fields with a delimiter.
fun _csv_join(fields, delimiter) {
    let text = "";
    for i in range(0, len(fields)) {
        if (i > 0)
        text = concat(text, delimiter);
        text = concat(text, fields[i]);
    }
    return text;
}
