// List growth, indexed reads, and numeric accumulation.
fun main() {
    let t0 = time()
    let entries = []
    let i = 0

    while i < 100_000 {
        entries += i * 3
        i++
    }

    let total = 0
    i = 0
    while (i <- ++i) < #entries
        total += entries[i]

    println(time() - t0)
}

main()
