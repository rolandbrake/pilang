// Bound instance-method call and return overhead.
class Worker {
    transform(value) {
        return value * 1.000_001 + 0.5;
    }
}

fun main() {
    let worker = Worker();
    let t0 = time()
    let i = 0;
    let value = 0;

    while i < 500_000 {
        value = worker.transform(value);
        i++;
    }

    println(time() - t0)
}

main()
