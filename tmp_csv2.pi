// CSV helper library for Pilang
// Provides lightweight parsing and stringification of CSV text.

fun _csv_parseLine(line, delimiter = ",") {
    fields = [];
    field = "";
    inQuotes = false;
    i = 0;

    while (i < len(line)) {
        ch = line[i];

        if (inQuotes) {
            if (ch == '"') {
                if (i + 1 < len(line) && line[i + 1] == '"') {
                    field = field + '"';
                    i = i + 1;
                } else {
                    inQuotes = false;
                }
            } else {
                field = field + ch;
            }
        } else {
            if (ch == '"') {
                inQuotes = true;
            } elif (ch == delimiter) {
                fields += field;
                field = "";
            } else {
                field = field + ch;
            }
        }

        i = i + 1;
    }

    fields += field;
    return fields;
}

fun _csv_escape(value, delimiter = ",") {
    if (value == nil)
        value = "";

    text = as_str(value);
    text = replace(text, '"', '""');

    if (contains(text, delimiter) || contains(text, "\n") || contains(text, "\r") || contains(text, '"')) {
        return '"' + text + '"';
    }

    return text;
}

fun parse(csv, delimiter = ",", header = true) {
    text = replace(csv, "\r\n", "\n");
    text = replace(text, "\r", "\n");

    rows = [];
    for line in split(text, "\n") {
        if (len(trim(line)) == 0)
            continue;
        rows += _csv_parseLine(line, delimiter);
    }

    if (len(rows) == 0)
        return [];

    if (!header)
        return rows;

    headers = rows[0];
    result = [];

    for i in range(1, len(rows)) {
        row = rows[i];
        record = {};

        for j in range(0, len(headers)) {
            key = headers[j];
            value = "";
            if (j < len(row))
                value = row[j];
            record[key] = value;
        }

        result += record;
    }

    return result;
}

fun stringify(rows, delimiter = ",") {
    if (len(rows) == 0)
        return "";

    first = rows[0];
    lines = [];

    if (is_map(first)) {
        headers = [];
        for key in first {
            headers += key;
        }

        headerFields = [];
        for key in headers {
            headerFields += _csv_escape(key, delimiter);
        }
        lines += _csv_join(headerFields, delimiter);

        for row in rows {
            values = [];
            for key in headers {
                values += _csv_escape(row[key], delimiter);
            }
            lines += _csv_join(values, delimiter);
        }
    } else {
        for row in rows {
            fields = [];
            for cell in row {
                fields += _csv_escape(cell, delimiter);
            }
            lines += _csv_join(fields, delimiter);
        }
    }

    return _csv_join(lines, "\n");
}

fun _csv_join(fields, delimiter) {
    text = "";
    for i in range(0, len(fields)) {
        if (i > 0)
            text = text + delimiter;
        text = text + fields[i];
    }
    return text;
}
