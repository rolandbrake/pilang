l = [1, 2, 3, 4]

assert(l[0:4] == [1, 2, 3, 4], "slice 0:4 == [1, 2, 3, 4]")       // [1, 2, 3, 4]
assert(l[1:3] == [2, 3], "slice 1:3 == [2, 3]")       // [2, 3]

// Negative indices
assert(l[-1:4] == [4], "slice -1:4 == [4]")      // [4]
assert(l[-2:4] == [3, 4], "slice -2:4 == [3, 4]")      // [3, 4]
assert(l[-4:4] == [1, 2, 3, 4], "slice -4:4 == [1, 2, 3, 4]")      // [1, 2, 3, 4]

// Too negative
assert(l[-10:2] == [1, 2], "slice -10:2 == [1, 2]")     // [1, 2]
assert(l[-100:100] == [1, 2, 3, 4], "slice -100:100 == [1, 2, 3, 4]")  // [1, 2, 3, 4]

// Out of range
assert(l[0:100] == [1, 2, 3, 4], "slice 0:100 == [1, 2, 3, 4]")     // [1, 2, 3, 4]
assert(l[10:20] == [], "slice 10:20 == []")     // []

// Mixed
assert(l[-2:10] == [3, 4], "slice -2:10 == [3, 4]")     // [3, 4]
assert(l[-10:-1] == [1, 2, 3], "slice -10:-1 == [1, 2, 3]")    // [1, 2, 3]

// With step
assert(l[0:4:1] == [1, 2, 3, 4], "slice 0:4:1 == [1, 2, 3, 4]")     // [1, 2, 3, 4]
assert(l[0:4:2] == [1, 3], "slice 0:4:2 == [1, 3]")     // [1, 3]
assert(l[::-1] == [4, 3, 2, 1], "slice ::-1 == [4, 3, 2, 1]")      // [4, 3, 2, 1]
assert(l[3:0:-1] == [4, 3, 2], "slice 3:0:-1 == [4, 3, 2]")    // [4, 3, 2]
assert(l[-1:-5:-1] == [4, 3, 2, 1], "slice -1:-5:-1 == [4, 3, 2, 1]")  // [4, 3, 2, 1]

// Empty results
assert(l[2:2] == [], "slice 2:2 == []")       // []
assert(l[3:1] == [], "slice 3:1 == []")       // []
assert(l[1:3:-1] == [], "slice 1:3:-1 == []")    // []

// Slice assignment
l = [1, 2, 3, 4]
l[1:3] = [8, 9]
assert(l == [1, 8, 9, 4], "slice assignment should replace the selected range")

l[1:3] = [5, 6, 7]
assert(l == [1, 5, 6, 7, 4], "slice assignment should grow the list")

l[1:4] = [8]
assert(l == [1, 8, 4], "slice assignment should shrink the list")

l[3:1] = [9]
assert(l == [1, 8, 4, 9], "empty forward slice assignment should insert at the start bound")

l[0:4:2] = [7, 6]
assert(l == [7, 8, 6, 9], "stepped slice assignment should replace matching positions")
