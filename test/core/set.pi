import col.{add, clear, contains, copy}

// initialization
s = {1, 2, 3}
println("s =", s)

s2 = set([1, 2, 2, 3])
println("s2 =", s2)

empty = set()
println("empty =", empty)

// add operations
add(s, 4)
println("after add 4 ->", s) // should print {1, 2, 3, 4}

add(s, [1,2,3])
println("after add list [1,2,3] ->", s)

add(s, {1,2,3})
println("after add set {1,2,3} ->", s)

// remove operations
remove(s, 2)
println("after remove 2 ->", s)

remove(s, [1, 3])
println("after remove [1,3] ->", s)

remove(s, {4, 5})
println("after remove {4,5} ->", s)



// clear
clear(s)
println("after clear ->", s)

// basic checks
println("len(s) =", len(s))
println("contains 2 =", contains(s, 2))

c = copy(s)
println("copy(s) =", c)


// set operations
s1 = {1, 2, 3}
s2 = {3, 4, 5}

println("s1 =", s1)
println("s2 =", s2)

println("union =", union(s1, s2))
println("intersection =", intersection(s1, s2))
println("difference =", difference(s1, s2))
println("symmetric difference =", symmetric_diff(s1, s2))

println("issubset =", issubset(s1, s2))
println("issuperset =", issuperset(s1, s2))
println("isdisjoint =", isdisjoint(s1, s2))


// using operators
println("s1 | s2 =", s1 | s2)
println("s1 & s2 =", s1 & s2)
println("s1 - s2 =", s1 - s2)
println("s1 ^ s2 =", s1 ^ s2)

println("s1 <= s2 =", s1 <= s2)
println("s1 >= s2 =", s1 >= s2)


// additional operations
println("len(s1) =", len(s1))
println("min(s1) =", min(s1))
println("max(s1) =", max(s1))