class Counter {
    constructor() {
        this.count = 0
    }

    increment() {
        this.count = this.count + 1
        return this.count
    }
}

c = Counter()
assert(c.increment() == 1, "instance methods should preserve state")
assert(c.increment() == 2, "instance methods should preserve state")

class Adder {
    constructor() {
        this.base = 5
    }

    add(x, y) {
        return x + y + this.base
    }
}

adder = Adder()
assert(adder.add(1, 2) == 8, "instance methods should forward arguments")
