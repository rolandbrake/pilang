class Box {
    constructor(values) {
        this.values = values
    }

    getItem(index) {
        return this.values[index]
    }

    setItem(index, value) {
        this.values[index] = value
    }

    slice(start, end, step) {
        return this.values[start:end:step]
    }
}

box = Box([10, 20, 30, 40, 50])

assert(box.getItem(1) == 20, "instance methods should provide indexed access")

box.setItem(2, 99)
assert(box.getItem(2) == 99, "instance methods should provide indexed assignment")

part = box.slice(1, 4, 2)
assert(part[0] == 20, "instance slice method should preserve the start")
assert(part[1] == 40, "instance slice method should preserve the step")

println("object index methods")
println(box.getItem(1))
println(box.getItem(2))
println(part)
