class Animal {
}

class Dog : Animal {
}

let dog = Dog();

assert(dog is Dog, "instance should match its class");
assert(dog is Animal, "instance should match parent class");
assert(dog is Object, "instance should match Object");
assert(Dog is Animal, "class prototype should match parent prototype");
assert(!(10 is Object), "primitive numbers should not match Object");
assert(!("pi" is Object), "primitive strings should not match Object");
