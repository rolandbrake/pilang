class Base {
    TAG = "base"
}

class User : Base {
    NAME = "Ada"
    AGE = 32
}

class Copy : Base {
    NAME = "Ada"
    AGE = 22
}

assert(User.type() == "class", "class type should be class")
assert(User.equals(Copy) == false, "different classes should not be equal")
assert(User.ident(User), "ident should recognize the same class")
assert(User.has("NAME"), "class member should exist")
assert(User.get("NAME") == "Ada", "class member should be readable")

User.set("role", "admin")
assert(User.get("role") == "admin", "class member should be writable")
assert(User.delete("role"), "class member should be deletable")
assert(!User.has("role"), "deleted member should be absent")
assert(User.get("TAG") == "base", "inherited member should be readable")

it = User.iterator()
assert(it.next() != nil, "class iterator should produce members")
assert(Object.type(User) == "class", "Object.type should identify classes")
assert(Object.get(User, "AGE") == 32, "Object.get should read class members")

user = User()
assert(user.type() == "User", "instance type should be its class name")
assert(user.get("NAME") == "Ada", "instance should read inherited class members")
println(user)
