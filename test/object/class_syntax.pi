class Animal {
    TYPE = "Animal"

    constructor(name) {
        this.name = name
    }

    format() {
        return "Animal(name = " + this.name + ")"
    }
}

class Dog : Animal {
    TYPE = "Dog"

    constructor(name, age) {
        super(name)
        this.age = age
    }

    format() {
        return "Dog(name = " + this.name + ", age = " + this.age + ")"
    }
}

dog = Dog("Buddy", 5)
println(Dog.TYPE)
println(Object.name(Dog))
println(dog.format())
println(dog)
