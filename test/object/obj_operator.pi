class Box {
    VALUE = 10

    format() {
        return "Box(" + this.VALUE + ")"
    }

    equals(candidate) {
        return is_num(candidate) && candidate == this.VALUE
    }

    compare(rhs) {
        return this.VALUE - rhs
    }
}

box = Box()
assert(box.equals(10), "class equals should receive an argument")
assert(box.compare(8) == 2, "class compare should receive an argument")
assert(box.format() == "Box(10)", "class format should be callable")
assert(box.VALUE + 5 == 15, "static class fields should participate in arithmetic")
assert(1 + 1 == 2, "primitive arithmetic should keep working")
println("class method use case")
println(box.format())
