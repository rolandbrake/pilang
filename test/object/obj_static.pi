class Point {
    VALUE = 10
    _PRIVATE = 3
    constructor(x, y) {
        this.x = x;
        this.y = y;
    }

    GetValue() {
        return Point.VALUE
    }
}

println(Point.GetValue())
point = Point(1, 2)
point.VALUE += 1
other = Point(3, 4);

println(point.VALUE)
println(other.VALUE)
println(Point.VALUE)
