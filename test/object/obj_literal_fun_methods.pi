let value = 10

class Box {
    Format() {
        return "Box(" + value + ")"
    }

    Equals(candidate) {
        return is_num(candidate) && candidate == value
    }

    Compare(rhs) {
        return value - rhs
    }
}

let box = Box()
assert(box.Equals(10), "class equals should receive the argument")
assert(box.Compare(8) == 2, "class compare should receive the argument")
assert(box.Format() == "Box(10)", "class format should be callable")
println("ok")
