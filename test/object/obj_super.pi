class Point {
    C = 10

    label() {
        return "(" + this.x + ", " + this.y + ")"
    }

    constructor(x, y) {
        this.x = x
        this.y = y
    }
}

class ColorPoint : Point {
    constructor(x, y) {
        super(x, y)
    }

    label() {
        return super.label() + " ColorPoint"
    }
}

class ColorPoint2 : Point {
    constructor(x, y) {
        super(x, y)
    }

    label() {
        return super.label() + " ColorPoint2"
    }
}

point = Point(1, 2)
child = ColorPoint(3, 4)
println(point.label())
println(child.x)
println(child.y)
println(child.label())
child.C += 1
println(child.C)
println(ColorPoint.C)
println(Point.C)
