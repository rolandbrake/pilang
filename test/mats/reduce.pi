import matrix.{ones, eye, transpose, sum, mean, mult};

let batch = ones(2, 3)
let weights = eye(3, 3)
let feature = eye(1, 3)
let logits = mult(batch, transpose(feature))

println(batch)
println(transpose(batch))
println(sum(batch))
println(mean(batch))
println(mult(batch, weights))
println(feature)
println(transpose(feature))
println(logits)
println(sum(logits))
println(mean(logits))
