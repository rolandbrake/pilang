import net.socket

assert(type(socket.connect) == "function", "socket should expose connect")
assert(type(socket.send_all) == "function", "socket should expose send_all")
assert(type(socket.receive) == "function", "socket should expose receive")
assert(type(socket.close) == "function", "socket should expose close")
assert(type(socket.Socket) == "function", "socket should expose Socket")
assert(socket.AF_INET > 0, "socket should expose AF_INET")
assert(socket.SOCK_STREAM > 0, "socket should expose SOCK_STREAM")

client = socket.Socket(socket.AF_INET, socket.SOCK_STREAM)
socket.close(client)

