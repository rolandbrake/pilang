import tensor:ten;
import tensor.ones:make_ones;
import tensor.{eye:identity, size};

    let A = ten.ones(2, 2)
let B = make_ones(1, 3)
let I = identity(2, 2)

assert(ten.is_matrix(A), "module alias should expose module members")
assert(B[0, 1] == 1, "element alias should call exported function")
assert(size(I) == 4, "braced import with alias should work")

println(A)
println(B)
println(I)
