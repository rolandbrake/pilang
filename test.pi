import sys
import sys.{EXIT_SUCCESS}


println("=== SYS MODULE TEST ===")

// --- argv ---
println("\n[argv]")
args = sys.argv()
println("Argument count:", len(args))

for i in range(len(args)) 
    println("argv[", i, "] =", args[i])


// --- platform & version ---
println("\n[platform/version]")
println("Platform:", sys.platform())
println("Version:", sys.version())

// --- path ---
// println("\n[path]")
// println("Current working directory:", sys.path())

// --- pid ---
println("\n[pid]")
println("Process ID:", sys.pid())

// --- env ---
println("\n[env]")
home = sys.env("HOME")
if home == nil {
    println("HOME is not set")
} else {
    println("HOME =", home)
}

// Try a variable that probably doesn't exist
fake = sys.env("SOME_RANDOM_NON_EXISTENT_VAR")
println("Non-existent env:", fake)  // should println nil

// --- memory ---
println("\n[mem]")
mem_before = sys.mem()
println("Memory before allocation:", mem_before)

// allocate some data
big = []
for i in range(1000) 
    big[i] = "data_" + i


mem_after = sys.mem()
println("Memory after allocation:", mem_after)

// --- gc ---
println("\n[gc]")
big = nil  // release reference
sys.gc()

mem_after_gc = sys.mem()
println("Memory after GC:", mem_after_gc)

// --- assert ---
println("\n[assert]")
assert(1 == 1, "This should NOT fail")

// Uncomment to test failure:
// sys.assert(1 == 2, "This SHOULD fail")

// --- error ---
println("\n[error]")
error("This is a test error message")

// --- exit ---
println("\n[exit]")
println("Exiting with code 0...")
sys.exit(EXIT_SUCCESS)

// This should never run
println("If you see this, exit failed!")