Point = {
  c: 10,
  _private: 3,
  label() {
    return "Point";
  },
};


ColorPoint = {
  extends: Point,
  constructor() {
      super();
  },
  color: "red",
};


point = Point();
child = ColorPoint();

println(point.c);
println(child.c);
println(ColorPoint.c);
println(child.color);
println(child.label());

child.c++;

println(point.c);
println(child.c);
println(ColorPoint.c);
println(Point.c);
