let Animal = {
  constructor() {
    this.kind = "animal"
  },
  speak() {
    return "generic " + this.kind
  },
  format() {
    return this.kind
  },
  value() {
    return this.kind
  }

}

let Dog =  {
  constructor(name) {
    this.name = name
    this.kind = "dog"
  },
  speak() {
    return this.name + " says woof"
  }
}

Dog.extends(Animal)

let dog = Dog("Milo")
let animal = Animal()

println(animal.kind)
println(animal.speak())


println(dog is Dog)
println(dog.speak())

