import draw
import plot3d
import tensor
import math.{exp, sqrt}

let ctx = draw.canvas(600, 560, "Volcano")
let chart = plot3d.chart(ctx)

let size = 64
let z = tensor.zeros([size, size])

for r in 0..size {
    for c in 0..size {

        let x = (c - size / 2) / 6
        let y = (r - size / 2) / 6

        let d = sqrt(x * x + y * y)

        z[r, c] = exp(-0.2 * (d - 3) * (d - 3))
    }
}

plot3d.mesh(chart, z, 0x2563eb, 0xf97316, true)
plot3d.title(chart, "Volcano Ring")

plot3d.show(chart)
draw.run(ctx)
