import random
import io

const WIDTH = 30
const HEIGHT = 20

fun make_board() {
    let board = []

    for y in 0..HEIGHT {
        let row = []
        for x in 0..WIDTH
            row.push(0)
        board.push(row)
    }

    return board
}

fun make_snake() {
    return [
        [WIDTH / 2, HEIGHT / 2],
        [WIDTH / 2 - 1, HEIGHT / 2],
        [WIDTH / 2 - 2, HEIGHT / 2]
    ]
}

fun spawn_food(snake) {
    while (true) {
        let x = random.randint(0, WIDTH - 1)
        let y = random.randint(0, HEIGHT - 1)

        let found = false

        for part in snake {
            if (part[0] == x && part[1] == y) {
                found = true
                break
            }
        }

        if (!found)
            return [x, y]
    }
}

fun snake_contains(snake, x, y) {
    for part in snake {
        if (part[0] == x && part[1] == y)
            return true
    }

    return false
}

fun move_snake(snake, direction, grow) {

    let head = snake[0]

    let nx = head[0]
    let ny = head[1]

    if (direction == "left")
        nx--
    elif (direction == "right")
        nx++
    elif (direction == "up")
        ny--
    else
        ny++

    snake.insert(0, [nx, ny])

    if (!grow)
        snake.pop()

    return [nx, ny]
}

fun render(board, snake, food, score) {

    io.pos(0,0)

    //TODO: ERROR REPORTING POSITION MISMATCH
    printf("{0:fg:green bold}\n", "ASCII SNAKE")
    printf("{0:fg:white}Score: {1:d}\n", "", score)

    printf("+")

    for x in 0..WIDTH
        printf("--")

    printf("+\n")

    for y in 0..HEIGHT {

        printf("|")

        for x in 0..WIDTH {

            if (food[0] == x && food[1] == y) {

                printf("{0:fg:red bold}", "[]")

            } elif (snake_contains(snake,x,y)) {

                if (snake[0][0] == x && snake[0][1] == y)
                    printf("{0:fg:yellow bold}", "[]")
                else
                    printf("{0:fg:green bold}", "[]")

            } else {

                printf("  ")

            }

        }

        printf("|\n")

    }

    printf("+")

    for x in 0..WIDTH
        printf("--")

    printf("+\n")
}

fun play() {

    random.seed(time())

    io.clear()
    io.cursor(false)

    let board = make_board()

    let snake = make_snake()

    let food = spawn_food(snake)

    let direction = "right"

    let score = 0

    let running = true

    let delay = 150

    let last_move = time()

    while (running) {

        render(board,snake,food,score)

        let key = io.key(25)

        if (key != nil) {

            key = lower(key)

            if (key == "q")
                running = false

            elif (key == "a" || key == "left") {

                if (direction != "right")
                    direction = "left"

            } elif (key == "d" || key == "right") {

                if (direction != "left")
                    direction = "right"

            } elif (key == "w" || key == "up") {

                if (direction != "down")
                    direction = "up"

            } elif (key == "s" || key == "down") {

                if (direction != "up")
                    direction = "down"

            }

        }

        if (time() - last_move >= delay) {

            let head = snake[0]

            let nx = head[0]
            let ny = head[1]

            if (direction == "left")
                nx--
            elif (direction == "right")
                nx++
            elif (direction == "up")
                ny--
            else
                ny++

            if (nx < 0 || nx >= WIDTH || ny < 0 || ny >= HEIGHT)
                running = false

            for part in snake {
                if (part[0] == nx && part[1] == ny)
                    running = false
            }

            if (!running)
                break

            let grow = false

            if (nx == food[0] && ny == food[1]) {

                grow = true
                score += 10
                food = spawn_food(snake)

            }

            move_snake(snake,direction,grow)

            last_move = time()

        }

    }

    io.cursor(true)

    printf("{0:fg:red bold}\n", "GAME OVER")
    printf("{0:fg:white}Final Score: {1:d}\n","",score)

}

play()