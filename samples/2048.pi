import random:r
import io
import col

const SIZE = 4

fun empty_cells(board) {
    let cells = []
    for y in range(SIZE) {
        for x in range(SIZE) {
            if board[y][x] == 0
                push(cells, (y, x)) 
        }
    }
    return cells
}

fun add_tile(board) {
    let cells = empty_cells(board)
    if len(cells) == 0
        return

    let cell = r.choice(cells)
    board[cell[0]][cell[1]] = r.randint(1, 10) == 10 ? 4 : 2
}

fun merge(line) {
    let compact = [x : x in line : x != 0]

    let score = 0
    let merged = []
    let i = 0
    while i < len(compact) {
        if i + 1 < len(compact) {
            if compact[i] == compact[i + 1] {
                let value = compact[i] * 2
                push(merged, value)
                score += value
                i += 2
            }
            else {
                push(merged, compact[i])
                i++
            }
        }
        else {
            push(merged, compact[i])
            i++
        }
    }

    while len(merged) < SIZE
        push(merged, 0)

    return {line: merged, score: score}
}

fun move(board, direction) {
    let total = 0

    for i in range(SIZE) {
        let line
        if direction == "a" || direction == "d"
            line = copy(board[i])
        else {
            line = []
            for y in range(SIZE)
                push(line, board[y][i])
        }

        if direction == "d" || direction == "s"
            line = col.reverse(line)

        let result = merge(line)
        line = result.line

        if direction == "d" || direction == "s"
            line = col.reverse(line)

        if direction == "a" || direction == "d"
            board[i] = line
        else {
            for y in range(SIZE)
                board[y][i] = line[y]
        }

        total += result.score
    }

    return total
}

fun can_move(board) {
    if len(empty_cells(board)) > 0
        return true

    for y in range(SIZE) {
        for x in range(SIZE) {
            if y + 1 < SIZE {
                if board[y][x] == board[y + 1][x]
                    return true
            }
            if x + 1 < SIZE {
                if board[y][x] == board[y][x + 1]
                    return true
            }
        }
    }
    return false
}

fun contains_2048(board) {
    for row in board {
        for value in row {
            if value == 2048
                return true
        }
    }
    return false
}

fun draw_board(board, score, moves) {
    printf(char(27) + "[2J" + char(27) + "[H")
    println()
    println("2048    score: " + score + "    moves: " + moves)
    println("W/A/S/D = move | Q = quit")
    println("+------+------+------+------+")

    for row in board {
        let text = "|"
        for value in row {
            let cell = value == 0 ? "      " : format("{0:^6}", value)
            text += cell + "|"
        }
        println(text)
        println("+------+------+------+------+")
    }
}

fun play() {
    let board = []
    for _ in range(SIZE)
        push(board, repeat([0], SIZE))

    add_tile(board)
    add_tile(board)

    let score = 0
    let moves = 0

    while true {
        draw_board(board, score, moves)
        printf("> ")
        let command = io.key()
        if command == nil
            continue
        command = command.lower().trim()

        if command == "q" {
            println("QUIT    score: " + score)
            break
        }

        let direction = command
        if command == "up"
            direction = "w"
        elif command == "left"
            direction = "a"
        elif command == "down"
            direction = "s"
        elif command == "right"
            direction = "d"

        if direction != "w" && direction != "a" &&
           direction != "s" && direction != "d"
            continue

        let before = copy(board)
        score += move(board, direction)

        if board != before {
            moves++
            add_tile(board)

            if contains_2048(board) {
                draw_board(board, score, moves)
                println("YOU WIN!    score: " + score)
                break
            }

            if !can_move(board) {
                draw_board(board, score, moves)
                println("GAME OVER    score: " + score)
                break
            }
        }
    }
}

play()
