import draw
import plot

let ctx = draw.canvas(720, 520, "Stream Plot")
let chart = plot.chart(ctx)

let xs = []
let ys = []
let us = []
let vs = []

for y in -10..11 {
    for x in -10..11 {
        let dx = x / 5
        let dy = y / 5

        push(xs, x)
        push(ys, y)
        push(us, -dy)
        push(vs, dx)
    }
}

plot.streamplot(chart, xs, ys, us, vs)
plot.title(chart, "Circular Flow")
plot.xlabel(chart, "X")
plot.ylabel(chart, "Y")
plot.grid(chart, true)

plot.show(chart)
draw.run(ctx)
