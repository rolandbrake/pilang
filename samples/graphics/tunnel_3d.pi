import draw
import math.{sin, cos, floor}
import time.{clock}

WIDTH = 600
HEIGHT = 600
PI = 3.141592653589793
SIDES = 16
RINGS = 24

ctx = draw.canvas(WIDTH, HEIGHT, "PiLang tunnel")

started = clock()
fps_started = started
frame_count = 0
fps = 0

fun render(canvas) {
    let now = clock()
    let t = now - started

    draw.clear(canvas, 0x080818)

    let previous = []
    let ring = 0

    while ring < RINGS {
        let depth = 1 + ring + (1 - (t * 4 - floor(t * 4)))
        let radius = 650 / depth

        let center_x = WIDTH / 2 + sin(t + depth * .15) * 70
        let center_y = HEIGHT / 2 + cos(t * .7 + depth * .12) * 50

        let points = []
        let side = 0

        while side < SIDES {
            let angle = side / SIDES * PI * 2 + t * .25
            points.append({
                x: center_x + cos(angle) * radius,
                y: center_y + sin(angle) * radius
            })
            side += 1
        }

        let color = draw.COLOR_CYAN
        if ring % 3 == 0 color = draw.COLOR_MAGENTA

        side = 0
        while side < SIDES {
            let a = points[side]
            let b = points[(side + 1) % SIDES]
            draw.line(canvas, a.x, a.y, b.x, b.y, color)

            if ring > 0 {
                let p = previous[side]
                draw.line(
                    canvas, p.x, p.y, a.x, a.y,
                    draw.COLOR_INDIGO
                )
            }

            side += 1
        }

        previous = points
        ring += 1
    }

    frame_count += 1
    let elapsed = now - fps_started

    if elapsed >= 1 {
        fps = floor(frame_count / elapsed)
        frame_count = 0
        fps_started = now
    }

    draw.text(canvas, 16, 16, "FPS: " + fps, {
        color: draw.COLOR_WHITE, size: 15
    })
}

draw.on_frame(ctx, render)
draw.run(ctx)