// Rotating OBJ wireframe viewer for samples/graphics/monkey.obj.
// The loader supports vertex (v) and triangular face (f) records.


import fs
import draw
import string
import math.{sin, cos}
import type.{float, int}

WIDTH = 600
HEIGHT = 600
MODEL_PATH = "./monkey.obj"

ctx = draw.canvas(WIDTH, HEIGHT, "PiLang OBJ viewer - Suzanne")
vertices = []
faces = []
edges = []
angle = 0

fun face_index(token) {
    // OBJ indices start at one. The split also accepts v/vt/vn face tokens.
    return int(string.split(token, "/")[0]) - 1
}

fun add_edge(a, b, seen) {
    if a > b {
        let swap = a
        a = b
        b = swap
    }

    let key = a + ":" + b
    if seen[key] == nil {
        seen[key] = true
        edges.append([a, b])
    }
}

fun load_obj(path) {
    let file = fs.open(path, "r")
    let source = fs.read(file)
    fs.close(file)

    let seen_edges = {}
    for raw_line in string.split(source, "\n") {
        let parts = string.split(raw_line.trim(), " ")
        if #parts == 0 continue

        if parts[0] == "v" {
            vertices.append({
                x: float(parts[1]),
                y: float(parts[2]),
                z: float(parts[3])
            })
        }

        if parts[0] == "f" {
            let a = face_index(parts[1])
            let b = face_index(parts[2])
            let c = face_index(parts[3])
            faces.append([a, b, c])
            add_edge(a, b, seen_edges)
            add_edge(b, c, seen_edges)
            add_edge(c, a, seen_edges)
        }
    }
}

fun project(vertex, yaw_c, yaw_s, pitch_c, pitch_s) {
    let x = vertex.x * yaw_c - vertex.z * yaw_s
    let z = vertex.x * yaw_s + vertex.z * yaw_c
    let y = vertex.y * pitch_c - z * pitch_s
    let depth = vertex.y * pitch_s + z * pitch_c + 4.5

    return {x: WIDTH / 2 + x / depth * 480, y: HEIGHT / 2 - y / depth * 480}
}

fun render(canvas) {
    angle += .018
    let yaw_c = cos(angle)
    let yaw_s = sin(angle)

    let pitch_c = cos(.15)
    let pitch_s = -sin(.15)
    let projected = []

    for vertex in vertices {
        projected.append(project(vertex, yaw_c, yaw_s, pitch_c, pitch_s))
    }

    draw.clear(canvas, 0x10131F)
    for edge in edges {
        let a = projected[edge[0]]
        let b = projected[edge[1]]
        draw.line(canvas, a.x, a.y, b.x, b.y, draw.COLOR_CYAN)
    }
    
}

load_obj(MODEL_PATH)
draw.animate(ctx, render)
draw.run(ctx)



