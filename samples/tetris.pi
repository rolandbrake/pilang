// Tetris for the PiLang SDL draw API.
// Controls: Arrow keys or A/D move, Arrow Up or W rotates,
// Arrow Down soft-drops, Space hard-drops, P pauses, R restarts.

import draw,
       audio,
       random,
       time.{clock},
       math:m

const BOARD_WIDTH = 10,
      BOARD_HEIGHT = 20,
      CELL_SIZE = 26,
      BOARD_X = 48,
      BOARD_Y = 40,
      WIDTH = 560,
      HEIGHT = 600


PIECES = [
    {kind: 0, rotations: [
        [[0, 1], [1, 1], [2, 1], [3, 1]],
        [[2, 0], [2, 1], [2, 2], [2, 3]],
        [[0, 2], [1, 2], [2, 2], [3, 2]],
        [[1, 0], [1, 1], [1, 2], [1, 3]]
    ]},

    {kind: 1, rotations: [
        [[1, 0], [2, 0], [1, 1], [2, 1]],
        [[1, 0], [2, 0], [1, 1], [2, 1]],
        [[1, 0], [2, 0], [1, 1], [2, 1]],
        [[1, 0], [2, 0], [1, 1], [2, 1]]
    ]},
    
    {kind: 2, rotations: [
        [[1, 0], [0, 1], [1, 1], [2, 1]],
        [[1, 0], [1, 1], [2, 1], [1, 2]],
        [[0, 1], [1, 1], [2, 1], [1, 2]],
        [[1, 0], [0, 1], [1, 1], [1, 2]]
    ]},

    {kind: 3, rotations: [
        [[1, 0], [2, 0], [0, 1], [1, 1]],
        [[1, 0], [1, 1], [2, 1], [2, 2]],
        [[1, 1], [2, 1], [0, 2], [1, 2]],
        [[0, 0], [0, 1], [1, 1], [1, 2]]
    ]},

    {kind: 4, rotations: [
        [[0, 0], [1, 0], [1, 1], [2, 1]],
        [[2, 0], [1, 1], [2, 1], [1, 2]],
        [[0, 1], [1, 1], [1, 2], [2, 2]],
        [[1, 0], [0, 1], [1, 1], [0, 2]]
    ]},

    {kind: 5, rotations: [
        [[0, 0], [0, 1], [1, 1], [2, 1]],
        [[1, 0], [2, 0], [1, 1], [1, 2]],
        [[0, 1], [1, 1], [2, 1], [2, 2]],
        [[1, 0], [1, 1], [0, 2], [1, 2]]
    ]},
    
    {kind: 6, rotations: [
        [[2, 0], [0, 1], [1, 1], [2, 1]],
        [[1, 0], [1, 1], [1, 2], [2, 2]],
        [[0, 1], [1, 1], [2, 1], [0, 2]],
        [[0, 0], [1, 0], [1, 1], [1, 2]]
    ]}
]

COLORS = [
    draw.COLOR_CYAN,
    draw.COLOR_YELLOW,
    draw.COLOR_MAGENTA,
    draw.COLOR_LIME,
    draw.COLOR_RED,
    draw.COLOR_BLUE,
    draw.COLOR_ORANGE
]

ctx = draw.canvas(WIDTH, HEIGHT, "PiLang Tetris")
clear_sound = audio.tone(880, .18)

board = []
piece = nil
next = nil
score = 0
lines = 0
over = false
paused = false
fall_time = 0.0
frame_time = clock()

left_old = false
right_old = false
down_old = false
rotate_old = false
drop_old = false
pause_old = false
restart_old = false
left_wait = 0.0
right_wait = 0.0
down_wait = 0.0

fun make_board() {
    let rows = []
    for y in 0..BOARD_HEIGHT {
        let row = []
        for x in 0..BOARD_WIDTH
            row.push(0)
        rows.push(row)
    }
    return rows
}

fun random_piece() {
    return {
        kind: random.randint(0, #PIECES - 1),
        rotation: 0,
        x: 3,
        y: 0
    }
}

fun piece_blocks(active, px = nil, py = nil, rotation = nil) {
    if px == nil px = active.x
    if py == nil py = active.y
    if rotation == nil rotation = active.rotation

    let result = [],
        shape = PIECES[active.kind].rotations[rotation]
    for block in shape
        result.push([px + block[0], py + block[1]])
    return result
}

fun collides(active, px, py, rotation) {
    let shape = PIECES[active.kind].rotations[rotation]
    for block in shape {
        let bx = px + block[0],
            by = py + block[1]

        if bx < 0 || bx >= BOARD_WIDTH || by >= BOARD_HEIGHT
            return true
        if by >= 0 && board[by][bx] != 0
            return true
    }
    return false
}

fun try_move(dx, dy) {
    let nx = piece.x + dx,
        ny = piece.y + dy
    if !collides(piece, nx, ny, piece.rotation) {
        piece.x = nx
        piece.y = ny
        return true
    }
    return false
}

fun try_rotate() {
    let rot = (piece.rotation + 1) % 4,
        kicks = [0, -1, 1, -2, 2]

    for dx in kicks {
        let nx = piece.x + dx

        if !collides(piece, nx, piece.y, rot) {
            piece.x = nx
            piece.rotation = rot
            return true
        }
    }

    return false
}

fun lock_piece() {
    for block in piece_blocks(piece) {
        let bx = block[0],
            by = block[1]
        if by >= 0
            board[by][bx] = piece.kind + 1
    }
}

fun clear_lines() {
    let kept = [],
        cleared = 0

    for row in board {
        let full = true
        for cell in row {
            if cell == 0 full = false
        }
        if full
            cleared += 1
        else
            kept.push(row)
    }

    while #kept < BOARD_HEIGHT {
        let row = []

        for x in 0..BOARD_WIDTH
            row.push(0)

        kept.insert(0, row)
    }

    board = kept

    if cleared > 0 {
        lines += cleared

        if cleared == 1
            score += 100
        elif cleared == 2
            score += 300
        elif cleared == 3
            score += 500
        elif cleared == 4
            score += 800

        audio.play(clear_sound)
    }

    return cleared
}

fun spawn_piece() {
    piece = next
    piece.x = 3
    piece.y = 0
    piece.rotation = 0
    next = random_piece()

    if collides(piece, piece.x, piece.y, piece.rotation)
        over = true
}

fun hard_drop() {
    let distance = 0

    while try_move(0, 1) {
        distance += 1
    }

    score += distance * 2
    lock_piece()
    clear_lines()
    spawn_piece()
}

fun soft_drop() {
    if !try_move(0, 1) {
        lock_piece()
        clear_lines()
        spawn_piece()
    } else {
        score += 1
    }
}

fun speed() {
    let result = .72 - lines * .015
    if result < .12 result = .12
    return result
}

fun start_game() {
    random.seed(m.floor(clock() * 1000000))

    board = make_board()
    next = random_piece()

    score = 0
    lines = 0
    over = false
    paused = false

    fall_time = 0.0
    left_wait = 0.0
    right_wait = 0.0
    down_wait = 0.0
    left_old = false
    right_old = false
    down_old = false
    rotate_old = false
    drop_old = false
    pause_old = false
    restart_old = false

    spawn_piece()
}

fun update(canvas, dt) {
    let r_down = draw.key(canvas, draw.KEY_R)

    if r_down && !restart_old
        start_game()

    restart_old = r_down

    if over return

    let p_down = draw.key(canvas, draw.KEY_P)

    if p_down && !pause_old
        paused = !paused

    pause_old = p_down
    if paused return

    let left_down = draw.key(canvas, draw.KEY_LEFT)   || draw.key(canvas, draw.KEY_A),
        right_down = draw.key(canvas, draw.KEY_RIGHT) || draw.key(canvas, draw.KEY_D),
        down_down = draw.key(canvas, draw.KEY_DOWN)   || draw.key(canvas, draw.KEY_S),
        rotate_down = draw.key(canvas, draw.KEY_UP)   || draw.key(canvas, draw.KEY_W),
        drop_down = draw.key(canvas, draw.KEY_SPACE)

    if left_down {
        if !left_old {
            try_move(-1, 0)
            left_wait = .2
        } else {
            left_wait -= dt
            if left_wait <= 0 {
                try_move(-1, 0)
                left_wait = .08
            }
        }
    } else {
        left_wait = 0.0
    }

    if right_down {
        if !right_old {
            try_move(1, 0)
            right_wait = .2
        } else {
            right_wait -= dt
            if right_wait <= 0 {
                try_move(1, 0)
                right_wait = .08
            }
        }
    } else {
        right_wait = 0.0
    }

    if down_down {
        if !down_old {
            soft_drop()
            down_wait = .06
        } else {
            down_wait -= dt
            if down_wait <= 0 {
                soft_drop()
                down_wait = .06
            }
        }
    } else {
        down_wait = 0.0
    }

    if rotate_down && !rotate_old try_rotate()
    if drop_down && !drop_old hard_drop()

    left_old = left_down
    right_old = right_down
    down_old = down_down
    rotate_old = rotate_down
    drop_old = drop_down

    fall_time += dt

    let interval = speed()

    while fall_time >= interval && !over {
        fall_time -= interval
        soft_drop()
    }
}

fun draw_block(canvas, bx, by, kind) {
    let px = BOARD_X + bx * CELL_SIZE,
        py = BOARD_Y + by * CELL_SIZE,
        color = COLORS[kind - 1]

    draw.rect(canvas, px + 1, py + 1, CELL_SIZE - 2, CELL_SIZE - 2, color, true)
    draw.rect(canvas, px + 4, py + 4, CELL_SIZE - 8, CELL_SIZE - 8,
              0xFFFFFF, false)
}

fun draw_ghost(canvas) {
    if piece == nil || over
        return

    let ghost_y = piece.y,
        shape = PIECES[piece.kind].rotations[piece.rotation]

    while !collides(piece, piece.x, ghost_y + 1, piece.rotation)
        ghost_y += 1

    for block in shape {
        let px = BOARD_X + (piece.x + block[0]) * CELL_SIZE,
            py = BOARD_Y + (ghost_y + block[1]) * CELL_SIZE

        if ghost_y + block[1] >= 0
            draw.rect(canvas, px + 3, py + 3, CELL_SIZE - 6, CELL_SIZE - 6,
                      draw.COLOR_LIGHT_GRAY, false)
    }
}

fun draw_preview(canvas) {
    let title_x = 356

    draw.text(canvas, title_x, 58, "NEXT", {
        color: draw.COLOR_WHITE, size: 20, bold: true
    })
    draw.rect(canvas, title_x - 10, 88, 170, 142, 0x20263A, true)

    if next != nil {
        let shape = PIECES[next.kind].rotations[0],
            min_x = 99,
            min_y = 99,
            max_x = -1,
            max_y = -1
            
        for block in shape {
            if block[0] < min_x min_x = block[0]
            if block[0] > max_x max_x = block[0]
            if block[1] < min_y min_y = block[1]
            if block[1] > max_y max_y = block[1]
        }

        let box_x = title_x - 10,
            box_y = 88,
            box_width = 170,
            box_height = 142

        let shape_width = (max_x - min_x + 1) * CELL_SIZE,
            shape_height = (max_y - min_y + 1) * CELL_SIZE

        let start_x = box_x + (box_width - shape_width) / 2,
            start_y = box_y + (box_height - shape_height) / 2

        for block in shape {
            let px = start_x + (block[0] - min_x) * CELL_SIZE + 1,
                py = start_y + (block[1] - min_y) * CELL_SIZE + 1

            draw.rect(canvas, px, py, CELL_SIZE - 2, CELL_SIZE - 2,
                      COLORS[next.kind], true)
            draw.rect(canvas, px + 3, py + 3, CELL_SIZE - 8, CELL_SIZE - 8,
                      draw.COLOR_WHITE, false)
        }
    }
}

fun render(canvas) {
    let now = clock()
    let dt = now - frame_time
    frame_time = now

    if dt > .05 dt = .05
    if dt < 0 dt = 0

    update(canvas, dt)

    draw.clear(canvas, 0x10131F)

    draw.text(canvas, 356, 18, "TETRIS", {
        color: draw.COLOR_CYAN, size: 26, bold: true
    })

    draw.rect(canvas, BOARD_X - 3, BOARD_Y - 3,
              BOARD_WIDTH * CELL_SIZE + 6,
              BOARD_HEIGHT * CELL_SIZE + 6,
              draw.COLOR_LIGHT_GRAY, false)

    for y in 0..BOARD_HEIGHT {
        for x in 0..BOARD_WIDTH {
            if board[y][x] != 0
                draw_block(canvas, x, y, board[y][x])
            else
                draw.rect(canvas, BOARD_X + x * CELL_SIZE + 1,
                          BOARD_Y + y * CELL_SIZE + 1,
                          CELL_SIZE - 2, CELL_SIZE - 2,
                          0x171C2C, true)
        }
    }

    if piece != nil && !over {
        for block in piece_blocks(piece) {
            let bx = block[0],
                by = block[1]
            if by >= 0
                draw_block(canvas, bx, by, piece.kind + 1)
        }
    }

    draw_ghost(canvas)
    draw_preview(canvas)

    draw.text(canvas, 356, 264, "SCORE", {color: draw.COLOR_LIGHT_GRAY, size: 16, bold: true})
    draw.text(canvas, 356, 288, "" + score, {color: draw.COLOR_WHITE, size: 24, bold: true})
    draw.text(canvas, 356, 338, "LINES", {color: draw.COLOR_LIGHT_GRAY, size: 16, bold: true})
    draw.text(canvas, 356, 362, "" + lines, {color: draw.COLOR_WHITE, size: 24, bold: true})

    if paused {
        draw.rect(canvas, BOARD_X + 38, BOARD_Y + 224, 218, 74, 0x10131F, true)
        draw.text(canvas, BOARD_X + 92, BOARD_Y + 242, "PAUSED", {
            color: draw.COLOR_YELLOW, size: 24, bold: true
        })
    }

    if over {
        let box_width = 244,
            box_height = 126,
            box_x = BOARD_X + (BOARD_WIDTH * CELL_SIZE - box_width) / 2,
            box_y = BOARD_Y + (BOARD_HEIGHT * CELL_SIZE - box_height) / 2

        draw.rect(canvas, box_x, box_y, box_width, box_height, 0x10131F, true)
        draw.text(canvas, box_x + 37, box_y + 22, "GAME OVER", {
            color: draw.COLOR_RED, size: 24, bold: true
        })
        draw.text(canvas, box_x + 30, box_y + 66, "Press R to restart", {
            color: draw.COLOR_WHITE, size: 17, bold: true
        })
    }
}

start_game()
draw.animate(ctx, render)
draw.run(ctx)