import draw
import plot3d


let ctx = draw.canvas(760, 560, "Random 3D Scatter")
let chart = plot3d.chart(ctx)

// Group 1 (Blue)
let xs1 = []
let ys1 = []
let zs1 = []

// Group 2 (Red)
let xs2 = []
let ys2 = []
let zs2 = []

// Group 3 (Green)
let xs3 = []
let ys3 = []
let zs3 = []

for i in 0..100 {
    push(xs1, rand() * 10 - 5)
    push(ys1, rand() * 10 - 5)
    push(zs1, rand() * 10 - 5)

    push(xs2, rand() * 10 + 8)
    push(ys2, rand() * 10 - 5)
    push(zs2, rand() * 10 - 5)

    push(xs3, rand() * 10 + 3)
    push(ys3, rand() * 10 + 8)
    push(zs3, rand() * 10 - 5)
}

// Blue cluster
plot3d.scatter(chart, xs1, ys1, zs1, 0x2563eb, 5)

// Red cluster
plot3d.scatter(chart, xs2, ys2, zs2, 0xdc2626, 5)

// Green cluster
plot3d.scatter(chart, xs3, ys3, zs3, 0x16a34a, 5)

plot3d.title(chart, "Random 3D Scatter Groups")
plot3d.xlabel(chart, "X")
plot3d.ylabel(chart, "Y")
plot3d.zlabel(chart, "Z")

plot3d.show(chart)
draw.run(ctx)