import fs

f = fs.open("test.txt", "w")
println(f)

fs.write(f, "Hello from fs module\n")
fs.write(f, "Second line\n")
fs.close(f)

f = fs.open("test.txt", "r")
content = fs.read(f)
println(content)
fs.close(f)

println(fs.exists("test.txt"))
println(fs.isfile("test.txt"))
println(fs.isdir("."))

println(fs.size("test.txt"))

println(fs.basename("test.txt"))
println(fs.dirname("test.txt"))
println(fs.ext("test.txt"))
println(fs.abspath("test.txt"))

fs.copy("test.txt", "copy.txt")
fs.move("copy.txt", "moved.txt")

files = fs.listdir(".")

for file in files {
    println(file)
}

fs.delete("test.txt")
fs.delete("moved.txt")

println("Done")
