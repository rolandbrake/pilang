// Interactive demo: builtin plot (scatter, line, labels) + draw.run.
// Run from repo root:  pilang.exe examples/draw_plot_demo.pi
// Close the SDL window to exit (draw.run runs the event loop).

import draw
import plot
import math

let xs = [0, 1, 2, 3, 4, 5, 6]
let ys = [0, 2, 1, 3, 2, 4, 3]

let ctx = draw.canvas(720, 480, "PiLang - plot + draw demo")

let chart = plot.chart(ctx)

plot.scatter(chart, xs, ys)
plot.line(chart, xs, ys)
plot.title(chart, "Scatter + line")
plot.xlabel(chart, "x")
plot.ylabel(chart, "y")
plot.grid(chart, true)
plot.axes(chart, true)
plot.legend(chart, ["samples", "trend"])

// Second plot Example


x = math.linspace(-5, 5, 100)  // Generate 100 points from -5 to 5
fun f(x) {
    return x * x + 2 * x + 1 
}         // Compute the quadratic function values

ctx = draw.canvas(720, 480, "PiLang - plot + draw demo")
chart = plot.chart(ctx)
plot.func(chart, x, f)                // Plot the function
plot.title(chart, "Quadratic Function: f(x) = x² + 2x + 1")
plot.xlabel(chart, "x")
plot.ylabel(chart, "f(x)")

// third example: scatter plot 
ctx = draw.canvas(600, 600)
chart = plot.chart(ctx)

x = [5, 7, 8, 7, 2, 17, 2, 9, 4, 11, 12, 9, 6]
y = [99, 86, 87, 88, 111, 86, 103, 87, 94, 78, 77, 85, 86]


plot.scatter(chart, x, y, draw.COLOR_RED)  // blue crosses
plot.title(chart, "Sample Scatter Plot")
plot.xlabel(chart, "X axis")
plot.ylabel(chart, "Y axis")
plot.grid(chart, true)


