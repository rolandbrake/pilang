import func:f;

fun add1(x) {
    return x + 1
}

fun double(x) {
    return x * 2
}

fun add(a, b) {
    return a + b
}

fun sum_pair(pair) {
    return pair[0] + pair[1]
}


piped = f.pipe(add1, double)

composed = f.compose(double, add1)

plus5 = f.partial(add, 5)

spread_add = f.spread(add)

unspread_sum = f.unspread(sum_pair)

calls = 0

fun bump(x) {
    calls++
    return x * x
}


memo = f.memoize(bump)

once_val = 0
fun init() {
    once_val++
    return once_val
}

only_once = f.once(init)

gen = f.iterate(1, double)

assert(piped(3) == 8, "pipe should chain left to right")
assert(composed(3) == 8, "compose should chain right to left")
assert(plus5(7) == 12, "partial should pre-bind arguments")
assert(spread_add([2, 4]) == 6, "spread should unpack a list")
assert(unspread_sum(2, 4) == 6, "unspread should pack args into a list")
assert(f.apply(add, [3, 9]) == 12, "apply should call with a list of args")
assert(memo(6) == 36 && memo(6) == 36, "memoize should cache results")
assert(calls == 1, "memoize should avoid recomputing the same key")
assert(only_once() == 1 && only_once() == 1, "once should keep the first result")
assert(gen() == 1 && gen() == 2 && gen() == 4, "iterate should yield successive values")

println("func tests ok")
