// Interactive demo: builtin plot (scatter, line, labels) + draw.run.
// Run from repo root:  pi.exe examples/draw_plot_demo.pi
// Close the SDL window to exit (draw.run runs the event loop).

import draw
import plot
import math

let xs = [0, 1, 2, 3, 4, 5, 6]
let ys = [0, 2, 1, 3, 2, 4, 3]

let ctx = draw.canvas(720, 480, "PiLang — plot + draw demo")

let chart = plot.scatter(ctx, xs, ys)
chart = plot.line(chart, xs, ys)
chart = plot.title(chart, "Scatter + line")
chart = plot.xlabel(chart, "x")
chart = plot.ylabel(chart, "y")
chart = plot.grid(chart, true)
chart = plot.axes(chart, true)
chart = plot.legend(chart, ["samples", "trend"])

// Second plot Example


x = math.linspace(-5, 5, 100)  // Generate 100 points from -5 to 5
fun f(x) {
    return x * x + 2 * x + 1 
}         // Compute the quadratic function values

ctx = draw.canvas(720, 480, "PiLang — plot + draw demo")
chart = plot.chart(ctx)
plot.func(chart, x, f)                // Plot the function
plot.title("Quadratic Function: f(x) = x² + 2x + 1")
plot.xlabel("x")
plot.ylabel("f(x)")

