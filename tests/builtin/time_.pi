import time:t;

built = t.of(2025, 1, 15, 9, 30, 45)
parsed = t.parse("2025-01-15 09:30:45", "%Y-%m-%d %H:%M:%S")
formatted = t.format(built, "%Y/%m/%d %H:%M:%S")
iso_local = t.iso(built)
iso_utc = t.iso(t.utc())
now_local = t.now()
before = t.clock()
sleep(5)
after = t.clock()

fired = 0
fun once_cb() {
    fired++
}

ticks = 0
fun interval_cb() {
    ticks++
    return ticks < 3
}

timer = t.timer(1, once_cb)
interval = t.interval(1, interval_cb)

assert(formatted == "2025/01/15 09:30:45", "time.format should format constructed times")
assert(t.iso(parsed) == iso_local, "time.parse should rebuild the same timestamp for matching local fields")
assert(len(iso_utc) == 20, "time.iso should emit a compact ISO string for UTC times")
assert(now_local["year"] >= 2025, "time.now should return a populated Time map")
assert(t.millis() >= t.unix() * 1000, "time.millis should align with time.unix")
assert(after >= before, "time.clock should be monotonic")
assert(fired == 1 && timer["ticks"] == 1, "time.timer should invoke the callback once")
assert(ticks == 3 && interval["ticks"] == 3, "time.interval should repeat until the callback returns false")

println("time tests ok")
