s = {1, 2, 3} // set literal
s2 = set([1, 2, 2, 3])   // duplicates removed → {1, 2, 3}
empty = set()            // NOT {} (that creates a dict)
add(s, 4)                 // add single element
add(s, [1,2,3]) // add multiple element
add(s, {1,2,3}) // add from other list

remove(s, 2)              // remove element
remove(s, [1, 3])           // remove multiple elements
remove(s, {4, 5})           // remove from other list (no error if not found)

pop(s) // remove and return random element
clear(s) // remove all elements

len(s) // number of elements
contains(s, 2) // check if element is in set
copy(s) // create a shallow copy of the set


// set operations 
s1 = {1, 2, 3}
s2 = {3, 4, 5}
union(s1, s2) // {1, 2, 3, 4, 5}
intersection(s1, s2) // {3}
difference(s1, s2) // {1, 2}
s_diff(s1, s2) // {1, 2, 4, 5} symmetric difference

issubset(s1, s2) // False
issuperset(s1, s2) // False
isdisjoint(s1, s2) // False (they share element 3)

// using operators
s1 = {1, 2, 3}
s2 = {3, 4, 5}
s1 | s2 // union
s1 & s2 // intersection
s1 - s2 // difference
s1 ^ s2 // symmetric difference
a <= b // issubset
a >= b // issuperset

// additional operations
len(s1) // 3
min(s1) // 1
max(s1) // 3

