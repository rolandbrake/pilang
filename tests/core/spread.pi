fun pair(a, b) {
    return [a, b]
}

fun collect(a, b, c, d) {
    return [a, b, c, d]
}

let base = [2, 3]
let merged = [1, ...base, 4]
let chars = [..."pi"]
let matrix_rows = [[1, 2], [3, 4]]
let copied_matrix = [...matrix_rows]
let left = {a: 1, b: 2}
let right = {b: 7, d: 9}
let merged_map = {start: 0, ...left, mid: 4, ...right, end: 10}

assert(merged == [1, 2, 3, 4], "list spread should expand iterables inside list literals")
assert(chars == ["p", "i"], "string spread should expand into one-character strings")
assert(copied_matrix == [[1, 2], [3, 4]], "spread list literals should preserve iterable element order")
assert(merged_map["start"] == 0, "map spread should keep literal entries before spreads")
assert(merged_map["a"] == 1, "map spread should copy keys from earlier maps")
assert(merged_map["b"] == 7, "later spread maps should overwrite earlier keys")
assert(merged_map["mid"] == 4, "map spread should allow literal entries between spreads")
assert(merged_map["d"] == 9, "map spread should copy keys from later maps")
assert(merged_map["end"] == 10, "map spread should keep literal entries after spreads")

let called = collect(1, ...base, 4)
[a, b] = pair(...[8, 5])

assert(called == [1, 2, 3, 4], "spread calls should expand iterable positional arguments")
assert(a == 8, "spread calls should feed the first expanded item into the first parameter")
assert(b == 5, "spread calls should feed the second expanded item into the second parameter")

println(merged)
println(called)
println(merged_map["b"])
