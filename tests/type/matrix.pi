import tensor.{zeros, ones, eye, matmult, size};

let base = ones([2, 3])
let col = ones([2, 1]) * 10
let square = eye(3, 3)
let row = eye(1, 3)

println(base)
println(row)
println(col)
println(base + 2)
println(2 + base)
println(base + row)
println(base + col)
println(base * row)
println((base + col) / 2)
println(size(base + row))
println(square * square)
println(matmult(square, square))
