Counter = {
    count: 0,
    call() {
        this.count = this.count + 1
        return this.count
    }
}

c = Counter()
assert(c() == 1, "instance call should invoke call method")
assert(c() == 2, "callable instance should preserve state")

Adder = {
    base: 5,
    call(x, y) {
        return x + y + this.base
    }
}

adder = Adder()
assert(adder(1, 2) == 8, "instance call should forward positional arguments")
