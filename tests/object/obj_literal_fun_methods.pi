let value = 10

let Box = {
    format: fun() {
        return "Box(" + value + ")"
    },
    equals: fun(candidate) {
        return is_num(candidate) && candidate == value
    },
    compare: fun(rhs) {
        return value - rhs
    }
}

let box = Box()

assert(box == 10, "anonymous fun methods in object literals should bind arguments correctly")
assert(10 == box, "right-side equality should still work for anonymous fun methods")
assert(box > 8, "compare via anonymous fun method should receive rhs instead of this")
assert(box.format() == "Box(10)", "format via anonymous fun method should still work")
println("ok")
