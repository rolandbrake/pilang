import PiStatement
import TokenType

class PiIfStatement : PiStatement {
    constructor(
        token,
        lparen,
        cond,
        rparen,
        thenStmt,
        elseToken = nil,
        elseStmt = nil
    ) {
        super(
            token,
            (elseStmt != nil ? elseStmt : thenStmt).getLastToken()
        )

        this._ifToken = token
        this._lparen = lparen
        this._cond = cond
        this._rparen = rparen
        this._then = thenStmt
        this._elseToken = elseToken
        this._else = elseStmt
    }

    formatBody(stmt, indent) {
        return stmt.isBlock
            ? stmt.format(indent, true)
            : "\n" + stmt.format(indent + 2)
    }

    format(indent = 0, isElifChain = false) {
        let result = isElifChain
            ? ""
            : this.formatComments(this._ifToken, indent, "leading") +
              this.indent(indent) +
              "if" +
              this.formatComments(this._ifToken, indent, "trailing") +
              " "

        if this._lparen != nil {
            result += this.formatComments(this._lparen, indent, "leading") + "(" + this.formatComments(this._lparen, indent, "trailing")
        }
        result += this._cond.format(0)
        if this._rparen != nil {
            result += this.formatComments(this._rparen, indent, "leading") + ")" + this.formatComments(this._rparen, indent, "trailing")
        }
        result += this.formatBody(this._then, indent)

        if (this._else != nil) {
            result += this._then.isBlock
                ? " "
                : "\n" + this.indent(indent)

            if (this._elseToken.type == TokenType.ELIF) {
                result +=
                    "elif" +
                    this.formatComments(
                        this._elseToken,
                        indent,
                        "trailing"
                    ) +
                    " "
            } else {
                result +=
                    "else" +
                    this.formatComments(
                        this._elseToken,
                        indent,
                        "trailing"
                    ) +
                    (this._else is PiIfStatement ? " " : "")
            }

            result +=
                this._else is PiIfStatement
                    ? this._else.format(
                          indent,
                          this._elseToken.type == TokenType.ELIF
                      )
                    : this.formatBody(this._else, indent)
        }

        return result
    }

    minifyElse(stmt, context) {
        return stmt is PiIfStatement
            ? "elif(" +
              stmt._cond.minify(context) +
              ")" +
              stmt._then.minify(context) +
              (stmt._else != nil
                  ? this.minifyElse(stmt._else, context)
                  : "")
            : "else " + stmt.minify(context)
    }

    minify(context = nil) {
        return (
            "if(" +
            this._cond.minify(context) +
            ")" +
            this._then.minify(context) +
            (this._else != nil
                ? this.minifyElse(this._else, context)
                : "")
        )
    }
}
