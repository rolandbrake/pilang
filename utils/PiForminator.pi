fun transform(source, mode) {
    const scanner = PiScanner(source)
    const tokens = scanner.scanTokens()
    const parser = PiParser()
    const statements = parser.parse(tokens)

    if mode == "fmt" {
        return statements.format(0)
    }
    return statements.minify(PiContext(BUILTINS))
}

fun transformFile(mode, filePath) {
    if !fs.exists(filePath) {
        println(_RED + "Error: File not found at " + filePath + _RESET)
        sys.exit(1)
    }
    const file = fs.open(filePath)
    const source = fs.read(file)
    fs.close(file)

    let output = transform(source, mode)
    if len(output) > 0 {
        if output[-1] != "\n" {
            output += "\n"
        }
    } else {
        output = "\n"
    }

    const destination = fs.open(filePath, "w")
    fs.write(destination, output)
    fs.close(destination)
}

const _args = sys.argv()
if len(_args) < 3 {
    println("Usage: PiForminator.px <fmt|min> <file.pi>")
    sys.exit(1)
}

const mode = _args[1]
if mode != "fmt" && mode != "min" {
    println("Usage: PiForminator.px <fmt|min> <file.pi>")
    sys.exit(1)
}

transformFile(mode, _args[2])
