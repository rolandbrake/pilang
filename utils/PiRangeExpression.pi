import PiExpression

class PiRangeExpression : PiExpression {
    constructor(token, start, end, step = nil) {
        super(
            start.getStartToken(),
            (step != nil ? step : end).getLastToken()
        )

        this._start = start
        this._end = end
        this._step = step
    }

    format(indent = 0, comments = nil) {
        return (
            this._start.format(0, comments) +
            ".." +
            this._end.format(0, comments) +
            (
                this._step != nil
                    ? ":" + this._step.format(0, comments)
                    : ""
            )
        )
    }

    minify(context = nil) {
        return (
            this._start.minify(context) +
            ".." +
            this._end.minify(context) +
            (
                this._step != nil
                    ? ":" + this._step.minify(context)
                    : ""
            )
        )
    }
}
