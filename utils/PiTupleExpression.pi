import PiExpression

class PiTupleExpression : PiExpression {
    constructor(startToken, elements, commas, endToken) {
        super(startToken, endToken)

        this._startToken = startToken
        this._elements = elements
        this._commas = commas
        this._endToken = endToken
    }

    format(indent = 0) {
        const prefix =
            this.indent(indent) +
            this.formatComments(
                this._startToken,
                indent,
                "leading"
            )

        if len(this._elements) == 0 {
            return prefix + "()"
        }

        let parts = []

        for expr in this._elements {
            parts.push(expr.format(0).trim())
        }

        let result = prefix + "(" + parts.join(", ")

        if (
            len(this._elements) == 1 ||
            len(this._commas) >= len(this._elements)
        ) {
            result += ","
        }

        return result + ")"
    }

    minify(context = nil) {
        if len(this._elements) == 0 {
            return "()"
        }

        let parts = []

        for expr in this._elements {
            parts.push(expr.minify(context))
        }

        let result = "(" + parts.join(",")

        if (
            len(this._elements) == 1 ||
            len(this._commas) >= len(this._elements)
        ) {
            result += ","
        }

        return result + ")"
    }
}
