import random:a;import io:b;const c=10;const d=20;let e=[{name:"I",color:"cyan",rotations:[[[0,1],[1,1],[2,1],[3,1]],[[2,0],[2,1],[2,2],[2,3]],[[0,2],[1,2],[2,2],[3,2]],[[1,0],[1,1],[1,2],[1,3]]]},{name:"O",color:"yellow",rotations:[[[1,0],[2,0],[1,1],[2,1]],[[1,0],[2,0],[1,1],[2,1]],[[1,0],[2,0],[1,1],[2,1]],[[1,0],[2,0],[1,1],[2,1]]]},{name:"T",color:"magenta",rotations:[[[1,0],[0,1],[1,1],[2,1]],[[1,0],[1,1],[2,1],[1,2]],[[0,1],[1,1],[2,1],[1,2]],[[1,0],[0,1],[1,1],[1,2]]]},{name:"S",color:"green",rotations:[[[1,0],[2,0],[0,1],[1,1]],[[1,0],[1,1],[2,1],[2,2]],[[1,1],[2,1],[0,2],[1,2]],[[0,0],[0,1],[1,1],[1,2]]]},{name:"Z",color:"red",rotations:[[[0,0],[1,0],[1,1],[2,1]],[[2,0],[1,1],[2,1],[1,2]],[[0,1],[1,1],[1,2],[2,2]],[[1,0],[0,1],[1,1],[0,2]]]},{name:"J",color:"blue",rotations:[[[0,0],[0,1],[1,1],[2,1]],[[1,0],[2,0],[1,1],[1,2]],[[0,1],[1,1],[2,1],[2,2]],[[1,0],[1,1],[0,2],[1,2]]]},{name:"L",color:"white",rotations:[[[2,0],[0,1],[1,1],[2,1]],[[1,0],[1,1],[1,2],[2,2]],[[0,1],[1,1],[2,1],[0,2]],[[0,0],[1,0],[1,1],[1,2]]]}];fun f(){let g=[];for(h in 0..d){let i=[];for(j in 0..c)i.push(0);g.push(i);}return g;}fun k(){return {kind:a.randint(0,#e-1),rotation:0,x:3,y:0};}fun l(m,j=nil,h=nil,n=nil){if(j==nil)j=m.x;if(h==nil)h=m.y;if(n==nil)n=m.rotation;let o=e[m.kind].rotations[n];let p=[];for(q in o)p.push([j+q[0],h+q[1]]);return p;}fun r(p,j,h){for(q in p){if(q[0]==j&&q[1]==h)return true;}return false;}fun s(g,m,j,h,n){let p=l(m,j,h,n);for(q in p){let t=q[0];let u=q[1];if(((t<0||t>=c)||u<0)||u>=d)return true;if(g[u][t]!=0)return true;}return false;}fun v(g,m,w,x){let y=m.x+w;let z=m.y+x;if(!s(g,m,y,z,m.rotation)){m.x=y;m.y=z;return true;}return false;}fun ba(g,m){let bb=(m.rotation+1)%4;if(!s(g,m,m.x,m.y,bb)){m.rotation=bb;return true;}if(!s(g,m,m.x-1,m.y,bb)){m.x--;m.rotation=bb;return true;}if(!s(g,m,m.x+1,m.y,bb)){m.x++;m.rotation=bb;return true;}return false;}fun bc(g,m){let p=l(m);for(q in p)g[q[1]][q[0]]=m.kind+1;}fun bd(i){for(be in i){if(be==0)return false;}return true;}fun bf(){let i=[];for(j in 0..c)i.push(0);return i;}fun bg(g){let bh=[];let bi=0;for(i in g){if(bd(i))bi++;else bh.push(i);}while(#bh<d)bh.insert(0,bf());for(h in 0..d)g[h]=bh[h];return bi;}fun bj(bk){if(bk==1)return 100;if(bk==2)return 300;if(bk==3)return 500;if(bk==4)return 800;return 0;}fun bl(bm){if(bm==0){printf("  ");}elif(bm==1){printf("{0:fg:cyan bold}","[]");}elif(bm==2){printf("{0:fg:yellow bold}","[]");}elif(bm==3){printf("{0:fg:magenta bold}","[]");}elif(bm==4){printf("{0:fg:green bold}","[]");}elif(bm==5){printf("{0:fg:red bold}","[]");}elif(bm==6){printf("{0:fg:blue bold}","[]");}else {printf("{0:fg:white bold}","[]");}}fun bn(g,m,bo,bk,bp){b.pos(0,0);printf("{0:fg:cyan bold}  {1:fg:white} {2:d}  {3:fg:white} {4:d}  {5:fg:white} {6:d}\n","ASCII TETRIS","score",bo,"lines",bk,"turn",bp);printf("{0:fg:yellow} {1}\n","controls:","a/left | d/right | s/down | w/up rotate | space drop | q quit");printf("+");for(j in 0..c)printf("--");printf("+\n");let bq=l(m);for(h in 0..d){printf("|");for(j in 0..c){if(r(bq,j,h))bl(m.kind+1);else bl(g[h][j]);}printf("|\n");}printf("+");for(j in 0..c)printf("--");printf("+\n");}fun br(g,m){while(v(g,m,0,1))nil;}fun bs(g){let m=k();if(s(g,m,m.x,m.y,m.rotation))return nil;return m;}fun bt(){a.seed(time());b.clear();b.cursor(false);let g=f();let m=bs(g);let bo=0;let bk=0;let bp=1;let bu=500;let bv=time();let bw=m!=nil;let bx=false;let by=true;while(bw){if(by){bn(g,m,bo,bk,bp);by=false;}let bz=b.key(25);if(bz=="q"||bz=="quit"){bx=true;bw=false;}else {let ca=false;if(bz!=nil){bz=lower(bz);if(bz=="a"||bz=="left"){v(g,m,-1,0);by=true;}elif(bz=="d"||bz=="right"){v(g,m,1,0);by=true;}elif(bz=="s"||bz=="down"){if(!v(g,m,0,1))ca=true;by=true;}elif(bz=="w"||bz=="up"){ba(g,m);by=true;}elif(bz==" "){br(g,m);ca=true;by=true;}}if(time()-bv>=bu){if(!v(g,m,0,1))ca=true;bv=time();by=true;}if(ca){bc(g,m);let bi=bg(g);if(bi>0){bk+=bi;bo+=bj(bi);printf("{0:fg:yellow bold} {1:d} {2}\n","cleared",bi,"line(s)");}m=bs(g);if(m==nil)bw=false;bv=time();by=true;}if(by)bp++;}}b.cursor(true);if(bx)printf("{0:fg:yellow bold} {1:fg:white} {2:d}  {3:fg:white} {4:d}\n","QUIT","score",bo,"lines",bk);else {bn(g,{kind:0,rotation:0,x:-4,y:-4},bo,bk,bp);printf("{0:fg:red bold} {1:fg:white} {2:d}  {3:fg:white} {4:d}\n","GAME OVER","score",bo,"lines",bk);}}bt();